# App
APP_HOST=localhost:3000

# Twilio (SMS notifications) — optional, SMS silently skipped without these
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Slack (lead posts + ops alerts) — off unless SLACK_ENABLED=true
SLACK_ENABLED=false
# Leads channel webhook
SLACK_WEBHOOK_URL=

# Ops alerts (failed/retried notifications) — our Slack, not the client's. Optional, logs only without it
OPS_SLACK_WEBHOOK_URL=

# Cloudflare Turnstile (bot protection) — optional, forms work without it
# Turnstile failure adds spam score weight (0.5) but never blocks submission
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Structured Data (JSON-LD) — optional, set to any value to enable
ENABLE_STRUCTURED_DATA=

# AWS S3 (image uploads) — optional, falls back to local disk storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_REGION=us-east-1
