<%= form_with(model: [:admin, project, order_form], class: "space-y-6", data: { controller: "nested-form" }) do |f| %>
  <% if order_form.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-xl p-4">
      <ul class="list-disc list-inside text-red-700 text-sm">
        <% order_form.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm p-6 space-y-5">
    <h2 class="text-lg font-semibold text-gray-900">Supplier</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <%= f.label :supplier_name, class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.text_field :supplier_name, class: "input-admin w-full", required: true %>
      </div>
    </div>
    <div>
      <%= f.label :notes, "Order Notes", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
      <%= f.text_area :notes, rows: 2, class: "input-admin w-full resize-none" %>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm p-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-lg font-semibold text-gray-900">Line Items</h2>
    </div>

    <div id="line-items" data-nested-form-target="container">
      <%= f.fields_for :line_items do |li| %>
        <%= render "line_item_fields", f: li %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= f.fields_for :line_items, OrderLineItem.new, child_index: "NEW_RECORD" do |li| %>
        <%= render "line_item_fields", f: li %>
      <% end %>
    </template>

    <div class="mt-4">
      <button type="button" data-action="nested-form#add" class="px-4 py-2 text-sm font-medium text-accent bg-accent/10 rounded-lg hover:bg-accent/20 transition cursor-pointer">
        + Add Line Item
      </button>
    </div>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to "Cancel", admin_project_path(project), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition" %>
    <%= f.submit (order_form.persisted? ? "Update Order Form" : "Create Order Form"), class: "btn-admin" %>
  </div>
<% end %>
