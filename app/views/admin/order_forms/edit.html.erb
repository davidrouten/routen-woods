<div class="mb-6">
  <% if @project %>
    <%= link_to "&larr; Back to Order Form".html_safe, admin_project_order_form_path(@project, @order_form), class: "text-sm text-gray-500 hover:text-gray-700" %>
  <% else %>
    <%= link_to "&larr; Back to Order Form".html_safe, admin_order_form_path(@order_form), class: "text-sm text-gray-500 hover:text-gray-700" %>
  <% end %>
</div>

<h1 class="text-2xl font-bold text-gray-900 mb-6">Edit Order Form</h1>

<%= render "form", order_form: @order_form, project: @project %>
