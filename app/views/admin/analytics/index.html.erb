<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6 gap-3">
  <h1 class="text-2xl font-bold text-gray-900"><%= t("admin.nav.settings") %> — Analytics</h1>

  <div class="flex gap-2">
    <% %w[7d 30d 90d].each do |period| %>
      <%= link_to period,
            admin_analytics_path(period: period),
            class: "px-3 py-1.5 rounded-lg text-sm font-medium transition #{@period == period ? 'bg-primary text-white' : 'bg-white text-gray-600 hover:bg-gray-50 border border-gray-200'}" %>
    <% end %>
  </div>
</div>

<!-- Summary Stats -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
  <div class="bg-white rounded-xl shadow-sm p-6">
    <p class="text-sm text-gray-500 mb-1">Total Visits</p>
    <p class="text-3xl font-bold text-primary"><%= number_with_delimiter(@total_visits) %></p>
  </div>
  <div class="bg-white rounded-xl shadow-sm p-6">
    <p class="text-sm text-gray-500 mb-1">Unique Visitors</p>
    <p class="text-3xl font-bold text-primary"><%= number_with_delimiter(@unique_visitors) %></p>
  </div>
  <div class="bg-white rounded-xl shadow-sm p-6">
    <p class="text-sm text-gray-500 mb-1">Page Views</p>
    <p class="text-3xl font-bold text-primary"><%= number_with_delimiter(@total_pageviews) %></p>
  </div>
</div>

<!-- Traffic by Day -->
<div class="bg-white rounded-xl shadow-sm p-6 mb-8">
  <h2 class="text-lg font-semibold text-gray-900 mb-4">Visits by Day</h2>
  <% if @visits_over_time.any? { |_, v| v > 0 } %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="text-left py-2 pr-4 font-medium text-gray-500">Date</th>
            <th class="text-right py-2 pr-4 font-medium text-gray-500">Visits</th>
            <th class="text-right py-2 font-medium text-gray-500">Page Views</th>
          </tr>
        </thead>
        <tbody>
          <% @visits_over_time.reverse_each do |date, count| %>
            <tr class="border-b border-gray-100">
              <td class="py-2 pr-4 text-gray-700"><%= date.strftime("%b %-d, %Y") %></td>
              <td class="py-2 pr-4 text-right text-gray-900 font-medium"><%= number_with_delimiter(count) %></td>
              <td class="py-2 text-right text-gray-900 font-medium"><%= number_with_delimiter(@pageviews_over_time[date] || 0) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-sm text-gray-400">No visit data yet</p>
  <% end %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
  <!-- Top Pages -->
  <div class="bg-white rounded-xl shadow-sm p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Top Pages</h2>
    <% if @top_pages.any? %>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="text-left py-2 pr-4 font-medium text-gray-500">Page</th>
            <th class="text-right py-2 font-medium text-gray-500">Views</th>
          </tr>
        </thead>
        <tbody>
          <% @top_pages.each do |page, count| %>
            <tr class="border-b border-gray-100">
              <td class="py-2 pr-4 text-gray-700 truncate max-w-xs"><%= page %></td>
              <td class="py-2 text-right text-gray-900 font-medium"><%= number_with_delimiter(count) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-sm text-gray-400">No page view data yet</p>
    <% end %>
  </div>

  <!-- Referrers -->
  <div class="bg-white rounded-xl shadow-sm p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Top Referrers</h2>
    <% if @referrers.any? %>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="text-left py-2 pr-4 font-medium text-gray-500">Source</th>
            <th class="text-right py-2 font-medium text-gray-500">Visits</th>
          </tr>
        </thead>
        <tbody>
          <% @referrers.each do |domain, count| %>
            <tr class="border-b border-gray-100">
              <td class="py-2 pr-4 text-gray-700"><%= domain %></td>
              <td class="py-2 text-right text-gray-900 font-medium"><%= number_with_delimiter(count) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-sm text-gray-400">No referrer data yet</p>
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
  <!-- Browsers -->
  <div class="bg-white rounded-xl shadow-sm p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Browsers</h2>
    <% if @browsers.any? %>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="text-left py-2 pr-4 font-medium text-gray-500">Browser</th>
            <th class="text-right py-2 font-medium text-gray-500">Visits</th>
          </tr>
        </thead>
        <tbody>
          <% @browsers.each do |browser, count| %>
            <tr class="border-b border-gray-100">
              <td class="py-2 pr-4 text-gray-700"><%= browser %></td>
              <td class="py-2 text-right text-gray-900 font-medium"><%= number_with_delimiter(count) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-sm text-gray-400">No browser data yet</p>
    <% end %>
  </div>

  <!-- Devices -->
  <div class="bg-white rounded-xl shadow-sm p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Devices</h2>
    <% if @devices.any? %>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="text-left py-2 pr-4 font-medium text-gray-500">Device</th>
            <th class="text-right py-2 font-medium text-gray-500">Visits</th>
          </tr>
        </thead>
        <tbody>
          <% @devices.each do |device, count| %>
            <tr class="border-b border-gray-100">
              <td class="py-2 pr-4 text-gray-700"><%= device %></td>
              <td class="py-2 text-right text-gray-900 font-medium"><%= number_with_delimiter(count) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-sm text-gray-400">No device data yet</p>
    <% end %>
  </div>
</div>

<!-- Form Engagement -->
<div class="bg-white rounded-xl shadow-sm p-6 mb-8">
  <h2 class="text-lg font-semibold text-gray-900 mb-4">Form Page Views</h2>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
    <div>
      <p class="text-sm text-gray-500 mb-1">Contact Page Views</p>
      <p class="text-2xl font-bold text-primary"><%= number_with_delimiter(@form_views["/contact"] || 0) %></p>
    </div>
    <div>
      <p class="text-sm text-gray-500 mb-1">Home Page Views</p>
      <p class="text-2xl font-bold text-primary"><%= number_with_delimiter(@form_views["/"] || 0) %></p>
    </div>
    <div>
      <p class="text-sm text-gray-500 mb-1">Form Submissions</p>
      <p class="text-2xl font-bold text-primary"><%= number_with_delimiter(@form_submits) %></p>
    </div>
  </div>

  <% if @form_submits_by_page.any? %>
    <h3 class="text-base font-semibold text-gray-900 mt-6 mb-3">Submissions by Page</h3>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-200">
          <th class="text-left py-2 pr-4 font-medium text-gray-500">Page</th>
          <th class="text-right py-2 font-medium text-gray-500">Submissions</th>
        </tr>
      </thead>
      <tbody>
        <% @form_submits_by_page.each do |page, count| %>
          <tr class="border-b border-gray-100">
            <td class="py-2 pr-4 text-gray-700"><%= page %></td>
            <td class="py-2 text-right text-gray-900 font-medium"><%= number_with_delimiter(count) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>

<!-- Image Engagement -->
<div class="bg-white rounded-xl shadow-sm p-6 mb-8">
  <h2 class="text-lg font-semibold text-gray-900 mb-4">Image Views</h2>
  <div class="mb-4">
    <p class="text-sm text-gray-500 mb-1">Total Lightbox Opens</p>
    <p class="text-2xl font-bold text-primary"><%= number_with_delimiter(@image_views_total) %></p>
  </div>
  <% if @image_views_by_page.any? %>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-200">
          <th class="text-left py-2 pr-4 font-medium text-gray-500">Page</th>
          <th class="text-right py-2 font-medium text-gray-500">Opens</th>
        </tr>
      </thead>
      <tbody>
        <% @image_views_by_page.each do |page, count| %>
          <tr class="border-b border-gray-100">
            <td class="py-2 pr-4 text-gray-700"><%= page %></td>
            <td class="py-2 text-right text-gray-900 font-medium"><%= number_with_delimiter(count) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-sm text-gray-400">No image view data yet</p>
  <% end %>

  <% if @top_images.any? %>
    <h3 class="text-base font-semibold text-gray-900 mt-6 mb-3">Most Viewed Images</h3>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-200">
          <th class="text-left py-2 pr-4 font-medium text-gray-500">Image</th>
          <th class="text-right py-2 font-medium text-gray-500">Views</th>
        </tr>
      </thead>
      <tbody>
        <% @top_images.each do |name, count| %>
          <tr class="border-b border-gray-100">
            <td class="py-2 pr-4 text-gray-700"><%= name %></td>
            <td class="py-2 text-right text-gray-900 font-medium"><%= number_with_delimiter(count) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
