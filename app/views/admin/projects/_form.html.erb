<%= form_with(model: [:admin, project], class: "space-y-6") do |f| %>
  <% if project.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-xl p-4">
      <ul class="list-disc list-inside text-red-700 text-sm">
        <% project.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= f.hidden_field :lead_id if project.lead_id %>

  <div class="bg-white rounded-xl shadow-sm p-6 space-y-5">
    <h2 class="text-lg font-semibold text-gray-900">Project Details</h2>

    <div>
      <%= f.label :title, class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
      <%= f.text_field :title, class: "input-admin w-full", required: true %>
    </div>

    <div>
      <%= f.label :description, class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
      <%= f.text_area :description, rows: 3, class: "input-admin w-full resize-none" %>
    </div>

    <div>
      <%= f.label :internal_notes, "Internal Notes", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
      <%= f.text_area :internal_notes, rows: 2, class: "input-admin w-full resize-none" %>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm p-6 space-y-5"
       data-controller="customer-suggest"
       data-customer-suggest-current-id-value="<%= project.customer_id %>"
       data-customer-suggest-current-name-value="<%= project.customer&.full_name %>"
  >
    <h2 class="text-lg font-semibold text-gray-900">Client Info</h2>
    <%= f.hidden_field :customer_id, data: { customer_suggest_target: "customerId" } %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <%= f.label :email, class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.email_field :email, class: "input-admin w-full", data: { customer_suggest_target: "email", action: "blur->customer-suggest#lookup" } %>
      </div>
      <div>
        <%= f.label :phone, class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.telephone_field :phone, class: "input-admin w-full", data: { customer_suggest_target: "phone", action: "blur->customer-suggest#lookup" } %>
      </div>
    </div>

    <div data-customer-suggest-target="customerArea"></div>

    <div data-controller="address-map"
         data-address-map-business-lat-value="<%= t('business.admin_geo.latitude') %>"
         data-address-map-business-lng-value="<%= t('business.admin_geo.longitude') %>"
         data-address-map-business-label-value="<%= t('business.address.full') %>"
         class="flex flex-col md:flex-row gap-4 items-start">
      <div class="flex-1">
        <%= f.label :address, class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.text_field :address, class: "input-admin w-full", placeholder: "Full project address", data: { address_map_target: "fullAddress", action: "input->address-map#onAddressChange" } %>
        <p data-address-map-target="distance" class="hidden text-sm text-gray-500 font-medium mt-2"></p>
        <p data-address-map-target="error" class="hidden text-sm text-red-500 font-medium mt-2"></p>
      </div>
      <div class="md:w-72">
        <div data-address-map-target="map" class="hidden rounded-lg overflow-hidden" style="min-height: 200px;"></div>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm p-6 space-y-5">
    <h2 class="text-lg font-semibold text-gray-900">Financials</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <%= f.label :estimated_price, "Estimated Price", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.number_field :estimated_price, step: 0.01, min: 0, class: "input-admin w-full" %>
      </div>
      <div>
        <%= f.label :agreed_price, "Agreed Price", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.number_field :agreed_price, step: 0.01, min: 0, class: "input-admin w-full" %>
      </div>
      <div>
        <%= f.label :deposit_amount, "Deposit Amount", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.number_field :deposit_amount, step: 0.01, min: 0, class: "input-admin w-full" %>
      </div>
      <div>
        <%= f.label :balance_amount, "Balance Amount", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.number_field :balance_amount, step: 0.01, min: 0, class: "input-admin w-full" %>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm p-6 space-y-5"
       data-controller="schedule-calculator">
    <h2 class="text-lg font-semibold text-gray-900">Scheduling</h2>

    <div>
      <%= f.label :scheduled_start_date, "Start Date", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
      <%= f.date_field :scheduled_start_date,
            class: "input-admin w-full md:w-64",
            data: { schedule_calculator_target: "startDate", action: "change->schedule-calculator#calculate" } %>
    </div>

    <div>
      <%= f.label :estimated_duration_days, "Duration", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
      <div class="flex items-center gap-3">
        <%= f.number_field :estimated_duration_days,
              step: 0.5, min: 0.5,
              class: "input-admin w-32",
              data: { schedule_calculator_target: "duration", action: "input->schedule-calculator#calculate" } %>
        <span class="text-sm text-gray-500">work days</span>
      </div>
      <div class="flex flex-wrap gap-2 mt-3" data-schedule-calculator-target="presetButtons">
        <% [["1 day", 1], ["2 days", 2], ["3 days", 3], ["1 week", 5], ["1.5 weeks", 8], ["2 weeks", 10]].each do |label, val| %>
          <button type="button"
                  data-duration="<%= val %>"
                  data-action="schedule-calculator#selectPreset"
                  class="px-3 py-1 text-sm rounded-full cursor-pointer transition
                         <%= project.estimated_duration_days&.to_f == val.to_f ? 'bg-primary text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' %>">
            <%= label %>
          </button>
        <% end %>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <%= f.check_box :work_saturdays,
            class: "rounded border-gray-300 text-primary focus:ring-primary",
            data: { schedule_calculator_target: "workSaturdays", action: "change->schedule-calculator#calculate" } %>
      <%= f.label :work_saturdays, "Include Saturdays", class: "text-sm font-medium text-gray-700" %>
    </div>

    <div class="rounded-lg border border-gray-200 p-4">
      <p class="text-sm text-gray-500 mb-1">Schedule Preview</p>
      <p class="text-base font-semibold px-2 py-1 rounded inline-block transition"
         data-schedule-calculator-target="endDate">
        <%= project.schedule.formatted || "Set a start date and duration" %>
      </p>
    </div>

    <div class="pt-3 border-t border-gray-100">
      <div>
        <%= f.label :time_estimate, "Estimate Notes", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.text_field :time_estimate, class: "input-admin w-full", placeholder: "e.g. depends on parts arriving" %>
      </div>
    </div>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to "Cancel", (project.persisted? ? admin_project_path(project) : admin_projects_path), class: "btn-admin-secondary" %>
    <%= f.submit (project.persisted? ? "Update Project" : "Create Project"), class: "btn-admin" %>
  </div>
<% end %>
