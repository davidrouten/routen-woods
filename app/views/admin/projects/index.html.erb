<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Projects</h1>
  <%= link_to "New Project", new_admin_project_path, class: "btn-admin" %>
</div>

<!-- Filters -->
<div class="bg-white rounded-xl shadow-sm p-4 mb-6">
  <div class="flex flex-wrap gap-3 items-center">
    <%= link_to "All", admin_projects_path, class: "px-3 py-1.5 rounded-full text-sm font-medium #{params[:status].blank? ? 'bg-primary text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'} transition" %>
    <% Project.statuses.each_key do |status| %>
      <%= link_to status.titleize, admin_projects_path(status: status), class: "px-3 py-1.5 rounded-full text-sm font-medium #{params[:status] == status ? 'bg-primary text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'} transition" %>
    <% end %>
  </div>
</div>

<!-- Projects Table -->
<div class="bg-white rounded-xl shadow-sm overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= sort_link("Project", :project) %></th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= sort_link("Client", :client) %></th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= sort_link("Agreed Price", :price, default_desc: true) %></th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= sort_link("Schedule", :schedule, page_default: true) %></th>
        <th class="px-6 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @projects.each do |project| %>
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-4">
            <%= link_to admin_project_path(project), class: "font-medium text-gray-900 hover:text-accent" do %>
              <%= project.title %>
            <% end %>
          </td>
          <td class="px-6 py-4 text-sm text-gray-500">
            <% if project.lead %>
              <%= project.lead.first_name %> <%= project.lead.last_name %>
            <% end %>
          </td>
          <td class="px-6 py-4">
            <span class="inline-block px-2 py-1 rounded-full text-xs font-medium <%= project_status_color(project.status) %>"><%= project.status.titleize %></span>
          </td>
          <td class="px-6 py-4 text-sm text-gray-700">
            <%= project.agreed_price ? number_to_currency(project.agreed_price) : "—" %>
          </td>
          <td class="px-6 py-4 text-sm text-gray-500">
            <% if project.scheduled_start_date %>
              <%= project.scheduled_start_date.strftime("%b %d") %><% if project.scheduled_end_date %> – <%= project.scheduled_end_date.strftime("%b %d") %><% end %>
            <% else %>
              —
            <% end %>
          </td>
          <td class="px-6 py-4">
            <div class="flex justify-end">
              <div class="icon-btn-group">
                <%= link_to edit_admin_project_path(project), class: "icon-btn", title: "Edit" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                <% end %>
                <%= button_to admin_project_path(project), method: :delete, form_class: "contents", class: "icon-btn-destructive", title: "Delete", data: { turbo_confirm: "Delete this project?" } do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                <% end %>
              </div>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @projects.empty? %>
    <div class="text-center py-12">
      <p class="text-gray-400">No projects yet.</p>
    </div>
  <% end %>
</div>

<% if @pagy && @pagy.pages > 1 %>
  <div class="mt-6 flex justify-center">
    <%== @pagy.series_nav %>
  </div>
<% end %>
