<div class="mb-6">
  <%= link_to "&larr; Back to Projects".html_safe, admin_projects_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
</div>

<h1 class="text-2xl font-bold text-gray-900 mb-6">New Project</h1>

<% if @lead %>
  <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 mb-6">
    <p class="text-sm text-blue-800">Creating project from lead: <strong><%= @lead.first_name %> <%= @lead.last_name %></strong></p>
  </div>
<% end %>

<%= render "form", project: @project %>
