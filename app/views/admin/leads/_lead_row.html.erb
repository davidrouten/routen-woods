<tr class="<%= lead.status == 'booked' ? 'bg-orange-50 hover:bg-orange-100' : 'hover:bg-gray-50' %>" id="<%= dom_id(lead) %>">
  <td class="px-6 py-4">
    <div class="flex items-center gap-1.5">
      <%= link_to admin_lead_path(lead), class: "font-medium text-gray-900 hover:text-accent" do %>
        <%= lead.first_name %> <%= lead.last_name %>
      <% end %>
      <% if (lead.spam_score || 0) >= 0.7 %>
        <span class="tooltip text-red-400" data-tip="Spam likelihood: <%= ((lead.spam_score || 0) * 100).round %>%">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.168 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 6a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 6zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/></svg>
        </span>
      <% end %>
    </div>
  </td>
  <td class="px-6 py-4 text-sm text-gray-500">
    <% if lead.email.present? %><p><%= lead.email %></p><% end %>
    <% if lead.phone.present? %><p><%= format_phone(lead.phone) %></p><% end %>
  </td>
  <td class="px-6 py-4 text-sm text-gray-500"><%= budget_range_label(lead.budget_range) %></td>
  <td class="px-6 py-4 text-sm text-gray-500"><%= timeframe_label(lead.timeframe) %></td>
  <td class="px-6 py-4">
    <% if current_user_can?(:manage, :leads) %>
      <button class="inline-block px-2 py-1 rounded-full text-xs font-medium cursor-pointer hover:ring-2 hover:ring-accent transition <%= status_badge_color(lead.status) %>"
              data-action="click->modal#openContent"
              data-modal-target="#status_modal_<%= lead.id %>">
        <%= lead.status.titleize %>
      </button>
      <template id="status_modal_<%= lead.id %>">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Change Status</h3>
        <p class="text-gray-500 text-sm mb-4"><%= lead.first_name %> <%= lead.last_name %></p>
        <div class="flex flex-wrap gap-2">
          <% Lead.statuses.each_key do |s| %>
            <% next if s == lead.status %>
            <%= form_with url: transition_admin_lead_path(lead), method: :patch, class: "inline", data: { turbo_frame: "_top" } do |f| %>
              <%= f.hidden_field :status, value: s %>
              <%= f.hidden_field :current_view, value: current_view %>
              <%= f.submit s.titleize, class: "px-3 py-1.5 rounded-full text-xs font-medium cursor-pointer transition hover:ring-2 hover:ring-accent #{status_badge_color(s)}" %>
            <% end %>
          <% end %>
        </div>
        <div class="flex justify-end mt-6">
          <button data-role="modal-cancel" class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition cursor-pointer">Cancel</button>
        </div>
      </template>
    <% else %>
      <span class="inline-block px-2 py-1 rounded-full text-xs font-medium <%= status_badge_color(lead.status) %>"><%= lead.status.titleize %></span>
    <% end %>
  </td>
  <td class="px-6 py-4">
    <% if lead.lead_temperature.present? %>
      <span class="inline-flex items-center gap-1 whitespace-nowrap px-2 py-1 rounded-full text-xs font-medium <%= temperature_badge_color(lead.lead_temperature) %>"><%= lead.temperature_emoji %> <%= lead.lead_temperature.capitalize %></span>
    <% end %>
  </td>
  <td class="px-6 py-4 text-sm text-gray-500">
    <% location = [lead.address_city, lead.address_state].compact_blank.join(", ") %>
    <%= location.present? ? location : "—" %>
  </td>
  <td class="px-6 py-4 text-sm text-gray-500">
    <span class="tooltip" data-tip="<%= format_datetime(lead.created_at) %>"><%= time_ago_in_words(lead.created_at) %> ago</span>
  </td>
  <td class="px-6 py-4">
    <div class="flex justify-end">
      <% if current_user_can?(:manage, :leads) %>
        <% if current_view == :spam %>
          <div class="icon-btn-group">
            <%= button_to unmark_spam_admin_lead_path(lead), method: :patch, form_class: "contents", class: "icon-btn", title: "Restore", data: { turbo_confirm: "Restore #{lead.first_name} #{lead.last_name} from spam?" } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            <% end %>
            <% delete_message = "Permanently delete #{lead.first_name} #{lead.last_name}?" %>
            <% if lead.customer_will_be_deleted? %>
              <% delete_message += " This will also permanently delete customer \"#{lead.customer.full_name}\" (no other non-spam leads)." %>
            <% end %>
            <% delete_message += " This cannot be undone." %>
            <%= button_to admin_lead_path(lead), method: :delete, form_class: "contents", class: "icon-btn-destructive", title: "Delete", data: { turbo_confirm: delete_message } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            <% end %>
          </div>
        <% elsif current_view == :archived %>
          <div class="icon-btn-group">
            <%= button_to restore_admin_lead_path(lead), method: :patch, form_class: "contents", class: "icon-btn", title: "Restore", data: { turbo_confirm: "Restore #{lead.first_name} #{lead.last_name} from archive?" } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            <% end %>
          </div>
        <% else %>
          <div class="icon-btn-group">
            <%= link_to edit_admin_lead_path(lead), class: "icon-btn", title: "Edit" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
            <% end %>
            <%= button_to archive_admin_lead_path(lead), method: :patch, form_class: "contents", class: "icon-btn-destructive", title: "Archive", data: { turbo_confirm: "Archive #{lead.first_name} #{lead.last_name}? You can restore it later from the Archived view." } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
            <% end %>
            <%= button_to mark_spam_admin_lead_path(lead), method: :patch, form_class: "contents", class: "icon-btn-destructive", title: "Spam", data: { turbo_confirm: "Mark #{lead.first_name} #{lead.last_name} as spam?" } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </td>
</tr>
