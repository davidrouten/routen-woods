<tr class="<%= lead.status == 'booked' ? 'bg-orange-50 hover:bg-orange-100' : 'hover:bg-gray-50' %>" id="<%= dom_id(lead) %>">
  <td class="px-6 py-4">
    <div class="flex items-center gap-1.5">
      <%= link_to admin_lead_path(lead), class: "font-medium text-gray-900 hover:text-accent" do %>
        <%= lead.first_name %> <%= lead.last_name %>
      <% end %>
      <% if (lead.spam_score || 0) >= 0.7 %>
        <span class="tooltip text-red-400" data-tip="Spam likelihood: <%= ((lead.spam_score || 0) * 100).round %>%">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.168 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 6a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 6zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/></svg>
        </span>
      <% end %>
    </div>
  </td>
  <td class="px-6 py-4 text-sm text-gray-500">
    <% if lead.email.present? %><p><%= lead.email %></p><% end %>
    <% if lead.phone.present? %><p><%= lead.phone %></p><% end %>
  </td>
  <td class="px-6 py-4 text-sm text-gray-500"><%= budget_range_label(lead.budget_range) %></td>
  <td class="px-6 py-4 text-sm text-gray-500"><%= timeframe_label(lead.timeframe) %></td>
  <td class="px-6 py-4">
    <% if current_user_can?(:manage, :leads) %>
      <button class="inline-block px-2 py-1 rounded-full text-xs font-medium cursor-pointer hover:ring-2 hover:ring-accent transition <%= status_badge_color(lead.status) %>"
              data-action="click->modal#openContent"
              data-modal-target="#status_modal_<%= lead.id %>">
        <%= lead.status.titleize %>
      </button>
      <template id="status_modal_<%= lead.id %>">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Change Status</h3>
        <p class="text-gray-500 text-sm mb-4"><%= lead.first_name %> <%= lead.last_name %></p>
        <div class="flex flex-wrap gap-2">
          <% Lead.statuses.each_key do |s| %>
            <% next if s == lead.status %>
            <%= form_with url: transition_admin_lead_path(lead), method: :patch, class: "inline", data: { turbo_frame: "_top" } do |f| %>
              <%= f.hidden_field :status, value: s %>
              <%= f.hidden_field :current_view, value: current_view %>
              <%= f.submit s.titleize, class: "px-3 py-1.5 rounded-full text-xs font-medium cursor-pointer transition hover:ring-2 hover:ring-accent #{status_badge_color(s)}" %>
            <% end %>
          <% end %>
        </div>
        <div class="flex justify-end mt-6">
          <button data-role="modal-cancel" class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition cursor-pointer">Cancel</button>
        </div>
      </template>
    <% else %>
      <span class="inline-block px-2 py-1 rounded-full text-xs font-medium <%= status_badge_color(lead.status) %>"><%= lead.status.titleize %></span>
    <% end %>
  </td>
  <td class="px-6 py-4">
    <% if lead.lead_temperature.present? %>
      <span class="inline-flex items-center gap-1 whitespace-nowrap px-2 py-1 rounded-full text-xs font-medium <%= temperature_badge_color(lead.lead_temperature) %>"><%= lead.temperature_emoji %> <%= lead.lead_temperature.capitalize %></span>
    <% end %>
  </td>
  <td class="px-6 py-4 text-sm text-gray-500">
    <% location = [lead.address_city, lead.address_state].compact_blank.join(", ") %>
    <%= location.present? ? location : "—" %>
  </td>
  <td class="px-6 py-4 text-sm text-gray-500">
    <span class="tooltip" data-tip="<%= format_datetime(lead.created_at) %>"><%= time_ago_in_words(lead.created_at) %> ago</span>
  </td>
  <td class="px-6 py-4 text-sm">
    <div class="flex items-center gap-2">
      <% if current_user_can?(:manage, :leads) %>
        <% if current_view == :spam %>
          <%= button_to "Restore", unmark_spam_admin_lead_path(lead), method: :patch, class: "px-3 py-1 text-xs font-medium text-green-700 bg-green-50 rounded-md hover:bg-green-100 transition cursor-pointer" %>
        <% elsif current_view == :archived %>
          <%= button_to "Restore", restore_admin_lead_path(lead), method: :patch, class: "px-3 py-1 text-xs font-medium text-green-700 bg-green-50 rounded-md hover:bg-green-100 transition cursor-pointer" %>
        <% else %>
          <%= render "shared/confirm_button", url: mark_spam_admin_lead_path(lead), method: :patch, label: "Spam", title: "Mark as Spam", message: "Mark #{lead.first_name} #{lead.last_name} as spam? This will move the lead to the spam folder.", confirm_text: "Mark Spam", button_class: "btn-admin-link" %>
          <%= render "shared/confirm_button", url: archive_admin_lead_path(lead), method: :patch, label: "Archive", title: "Archive Lead", message: "Archive #{lead.first_name} #{lead.last_name}? You can restore it later from the Archived view.", danger: true, button_class: "px-3 py-1 text-xs font-medium text-red-600 bg-red-50 rounded-md hover:bg-red-100 transition cursor-pointer" %>
        <% end %>
      <% end %>
    </div>
  </td>
</tr>
