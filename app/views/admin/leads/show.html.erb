<div class="mb-6">
  <%= link_to "&larr; Back to Leads".html_safe, admin_leads_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Lead Info -->
  <div class="lg:col-span-2 space-y-6">
    <!-- Header Card -->
    <div class="bg-white rounded-xl shadow-sm p-6">
      <div class="flex justify-between items-start mb-4">
        <div>
          <h1 class="text-2xl font-bold text-gray-900">
            <% if @lead.lead_temperature.present? %><%= @lead.temperature_emoji %><% end %>
            <%= @lead.first_name %> <%= @lead.last_name %>
          </h1>
          <p class="text-gray-500"><%= @lead.service_interested_in&.titleize %></p>
        </div>
        <span class="inline-block px-3 py-1 rounded-full text-sm font-medium <%= status_badge_color(@lead.status) %>"><%= @lead.status.titleize %></span>
      </div>

      <div class="grid grid-cols-2 gap-4 text-sm">
        <% if @lead.email.present? %>
          <div>
            <p class="text-gray-500">Email</p>
            <p class="font-medium"><%= mail_to @lead.email, @lead.email, class: "text-[#d4a338] hover:text-[#b8860b]" %></p>
          </div>
        <% end %>
        <% if @lead.phone.present? %>
          <div>
            <p class="text-gray-500">Phone</p>
            <p class="font-medium"><%= link_to @lead.phone, "tel:#{@lead.phone}", class: "text-[#d4a338] hover:text-[#b8860b]" %></p>
          </div>
        <% end %>
        <div>
          <p class="text-gray-500">Source</p>
          <p class="font-medium"><%= @lead.source&.titleize || "—" %></p>
        </div>
        <div>
          <p class="text-gray-500">Submitted</p>
          <p class="font-medium"><%= @lead.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
        </div>
        <% if @lead.lead_temperature.present? %>
          <div>
            <p class="text-gray-500">Temperature</p>
            <p class="font-medium">
              <span class="inline-block px-2 py-1 rounded-full text-xs font-medium <%= temperature_badge_color(@lead.lead_temperature) %>"><%= @lead.temperature_emoji %> <%= @lead.lead_temperature.capitalize %> (Score: <%= @lead.ai_score.to_i %>)</span>
            </p>
          </div>
        <% end %>
        <% if @lead.spam_score > 0 %>
          <div>
            <p class="text-gray-500">Spam Score</p>
            <p class="font-medium text-red-600"><%= (@lead.spam_score * 100).to_i %>%</p>
          </div>
        <% end %>
      </div>

      <% if @lead.message.present? %>
        <div class="mt-4 pt-4 border-t border-gray-100">
          <p class="text-gray-500 text-sm mb-1">Message</p>
          <p class="text-gray-700"><%= @lead.message %></p>
        </div>
      <% end %>

      <!-- UTM Data -->
      <% if @lead.utm_source.present? || @lead.utm_medium.present? %>
        <div class="mt-4 pt-4 border-t border-gray-100">
          <p class="text-gray-500 text-sm mb-2">Campaign Data</p>
          <div class="flex flex-wrap gap-2">
            <% %w[utm_source utm_medium utm_campaign utm_term utm_content].each do |field| %>
              <% if @lead.send(field).present? %>
                <span class="inline-block bg-gray-100 text-gray-600 px-2 py-1 rounded text-xs"><%= field.sub('utm_', '') %>: <%= @lead.send(field) %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Notes Section -->
    <div class="bg-white rounded-xl shadow-sm p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Notes</h2>

      <% if current_user_can?(:create, :notes) %>
        <div class="mb-6">
          <%= form_with url: admin_lead_notes_path(@lead), class: "flex gap-3" do |f| %>
            <%= f.text_area :body, placeholder: "Add a note...", rows: 2, class: "flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#d4a338] focus:border-transparent outline-none resize-none text-sm", required: true %>
            <%= f.submit t("admin.leads.add_note"), class: "self-end px-4 py-2 bg-[#0f1b2d] text-white rounded-lg text-sm hover:bg-[#1b2a4a] transition cursor-pointer" %>
          <% end %>
        </div>
      <% end %>

      <div id="notes" class="space-y-4">
        <% @notes.each do |note| %>
          <div class="flex gap-3 p-3 rounded-lg bg-gray-50" id="<%= dom_id(note) %>">
            <div class="w-8 h-8 bg-[#d4a338] rounded-full flex-shrink-0 flex items-center justify-center text-[#0f1b2d] text-xs font-bold">
              <%= note.user.first_name[0] %><%= note.user.last_name[0] %>
            </div>
            <div class="flex-1">
              <div class="flex justify-between items-start">
                <p class="font-medium text-sm text-gray-900"><%= note.user.full_name %></p>
                <div class="flex items-center gap-2">
                  <span class="text-xs text-gray-400"><%= time_ago_in_words(note.created_at) %> ago</span>
                  <% if current_user.admin? || note.user == current_user %>
                    <%= button_to admin_lead_note_path(@lead, note), method: :delete, class: "text-red-400 hover:text-red-600 text-xs", data: { turbo_confirm: "Delete this note?" } do %>
                      &times;
                    <% end %>
                  <% end %>
                </div>
              </div>
              <p class="text-sm text-gray-700 mt-1"><%= note.body %></p>
              <% if note.note_type != "manual" %>
                <span class="inline-block mt-1 px-2 py-0.5 bg-blue-50 text-blue-600 text-xs rounded"><%= note.note_type %></span>
              <% end %>
            </div>
          </div>
        <% end %>
        <% if @notes.empty? %>
          <p class="text-gray-400 text-sm text-center py-4">No notes yet</p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Right Sidebar -->
  <div class="space-y-6">
    <!-- Status Transition -->
    <% if current_user_can?(:manage, :leads) %>
      <div class="bg-white rounded-xl shadow-sm p-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-3">Change Status</h3>
        <div class="space-y-2">
          <% Lead.statuses.each_key do |status| %>
            <% next if status == @lead.status %>
            <%= button_to t("admin.leads.status.#{status}"), transition_admin_lead_path(@lead, status: status), method: :patch, class: "w-full text-left px-3 py-2 rounded-lg text-sm font-medium #{status_badge_color(status)} hover:opacity-80 transition", data: { turbo_confirm: "Move to #{status}?" } %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Spam Actions -->
    <% if current_user_can?(:manage, :leads) %>
      <div class="bg-white rounded-xl shadow-sm p-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-3">Actions</h3>
        <% if @lead.spam? %>
          <%= button_to t("admin.leads.unmark_spam"), unmark_spam_admin_lead_path(@lead), method: :patch, class: "w-full px-3 py-2 bg-green-100 text-green-700 rounded-lg text-sm font-medium hover:bg-green-200 transition" %>
        <% else %>
          <%= button_to t("admin.leads.mark_spam"), mark_spam_admin_lead_path(@lead), method: :patch, class: "w-full px-3 py-2 bg-red-100 text-red-700 rounded-lg text-sm font-medium hover:bg-red-200 transition", data: { turbo_confirm: "Mark as spam?" } %>
        <% end %>
      </div>
    <% end %>

    <!-- Status History -->
    <div class="bg-white rounded-xl shadow-sm p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-3">Status History</h3>
      <div class="space-y-3">
        <% @status_changes.each do |change| %>
          <div class="flex items-start gap-2 text-sm">
            <div class="w-2 h-2 mt-1.5 rounded-full bg-[#d4a338] flex-shrink-0"></div>
            <div>
              <p class="text-gray-700">
                <span class="font-medium"><%= change.from_status&.titleize || "New" %></span>
                &rarr;
                <span class="font-medium"><%= change.to_status.titleize %></span>
              </p>
              <p class="text-xs text-gray-400"><%= change.user&.full_name || "System" %> &middot; <%= time_ago_in_words(change.created_at) %> ago</p>
            </div>
          </div>
        <% end %>
        <% if @status_changes.empty? %>
          <p class="text-gray-400 text-sm">No status changes yet</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
