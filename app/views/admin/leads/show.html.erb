<div class="mb-6">
  <%= link_to "&larr; Back to Leads".html_safe, admin_leads_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Lead Info -->
  <div class="lg:col-span-2 space-y-6">
    <!-- Header Card -->
    <div class="bg-white rounded-xl shadow-sm p-6">
      <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2 mb-4">
        <div>
          <h1 class="text-2xl font-bold text-gray-900">
            <% if @lead.lead_temperature.present? %><%= @lead.temperature_emoji %><% end %>
            <%= @lead.first_name %> <%= @lead.last_name %>
          </h1>
          <% if @lead.services_interested_in.present? %>
            <p class="text-gray-500"><%= @lead.service_names %></p>
          <% end %>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-block px-3 py-1 rounded-full text-sm font-medium <%= status_badge_color(@lead.status) %>"><%= @lead.status.titleize %></span>
          <% if current_user_can?(:manage, :leads) %>
            <%= link_to "Edit", edit_admin_lead_path(@lead), class: "btn-admin-link text-sm" %>
          <% end %>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 text-sm">
        <% if @lead.email.present? %>
          <div>
            <p class="text-gray-500">Email</p>
            <p class="font-medium"><%= mail_to @lead.email, @lead.email, class: "text-accent hover:text-accent-hover" %></p>
          </div>
        <% end %>
        <% if @lead.phone.present? %>
          <div>
            <p class="text-gray-500">Phone</p>
            <p class="font-medium"><%= link_to format_phone(@lead.phone), "tel:+1#{phone_digits(@lead.phone)}", class: "text-accent hover:text-accent-hover" %></p>
          </div>
        <% end %>
        <div>
          <p class="text-gray-500">Budget Range</p>
          <p class="font-medium"><%= budget_range_label(@lead.budget_range) %></p>
        </div>
        <div>
          <p class="text-gray-500">Timeframe</p>
          <p class="font-medium"><%= timeframe_label(@lead.timeframe) %></p>
        </div>
        <% if @lead.zip_code.present? %>
          <div>
            <p class="text-gray-500">Zip Code</p>
            <p class="font-medium"><%= @lead.zip_code %></p>
          </div>
        <% end %>
        <div>
          <p class="text-gray-500">Source</p>
          <p class="font-medium"><%= @lead.lead_source.present? ? @lead.lead_source : (@lead.source&.titleize || "—") %></p>
        </div>
        <% if @lead.lead_source_reference.present? %>
          <div>
            <p class="text-gray-500">Reference #</p>
            <p class="font-medium"><%= @lead.lead_source_reference %></p>
          </div>
        <% end %>
        <% if @lead.customer.present? %>
          <div>
            <p class="text-gray-500">Customer</p>
            <p class="font-medium"><%= link_to @lead.customer.full_name, admin_customer_path(@lead.customer), class: "text-accent hover:text-accent-hover" %></p>
          </div>
        <% end %>
        <div>
          <p class="text-gray-500">Submitted</p>
          <p class="font-medium"><%= format_datetime(@lead.created_at) %></p>
        </div>
        <div>
          <p class="text-gray-500">Entered By</p>
          <p class="font-medium"><%= @lead.created_by ? @lead.created_by.full_name : "Contact Form" %></p>
        </div>
        <% if @lead.form_page.present? %>
          <div>
            <p class="text-gray-500">Form Page</p>
            <p class="font-medium"><%= @lead.form_page.titleize %></p>
          </div>
        <% end %>
        <% if @lead.lead_temperature.present? %>
          <div>
            <p class="text-gray-500">Temperature</p>
            <p class="font-medium">
              <span class="inline-block px-2 py-1 rounded-full text-xs font-medium <%= temperature_badge_color(@lead.lead_temperature) %>"><%= @lead.temperature_emoji %> <%= @lead.lead_temperature.capitalize %> (Score: <%= @lead.ai_score.to_i %>)</span>
            </p>
          </div>
        <% end %>
        <% if @lead.spam_score > 0 %>
          <div>
            <p class="text-gray-500">Spam Score</p>
            <p class="font-medium text-red-600"><%= (@lead.spam_score * 100).to_i %>%</p>
          </div>
        <% end %>
      </div>

      <% if @lead.services_interested_in.present? || @lead.other_service.present? %>
        <div class="mt-4 pt-4 border-t border-gray-100">
          <p class="text-gray-500 text-sm mb-2">Services Interested In</p>
          <div class="flex flex-wrap gap-2">
            <% @lead.services_interested_in&.each do |svc| %>
              <span class="inline-block bg-accent/10 text-accent px-2.5 py-1 rounded-full text-xs font-medium"><%= I18n.t("business.services.#{svc}.name", default: svc.titleize) %></span>
            <% end %>
            <% if @lead.other_service.present? %>
              <span class="inline-block bg-accent/10 text-accent px-2.5 py-1 rounded-full text-xs font-medium">Other: <%= @lead.other_service %></span>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @lead.message.present? %>
        <div class="mt-4 pt-4 border-t border-gray-100">
          <p class="text-gray-500 text-sm mb-1">Message</p>
          <p class="text-gray-700 whitespace-pre-line"><%= @lead.message %></p>
        </div>
      <% end %>

      <% if @lead.address_street.present? || @lead.address_city.present? %>
        <div class="mt-4 pt-4 border-t border-gray-100"
             data-controller="address-map"
             data-address-map-business-lat-value="<%= t('business.admin_geo.latitude') %>"
             data-address-map-business-lng-value="<%= t('business.admin_geo.longitude') %>"
             data-address-map-business-label-value="<%= t('business.address.full') %>">
          <div class="flex flex-col md:flex-row gap-4">
            <div class="flex-1">
              <p class="text-gray-500 text-sm mb-1">Address</p>
              <p class="text-gray-700">
                <%= @lead.address_street %><br>
                <% if @lead.address_street2.present? %><%= @lead.address_street2 %><br><% end %>
                <%= [@lead.address_city, @lead.address_state].compact_blank.join(", ") %> <%= @lead.address_zip %>
              </p>
              <p data-address-map-target="distance" class="hidden text-sm text-gray-500 font-medium mt-2"></p>
              <p data-address-map-target="error" class="hidden text-sm text-red-500 font-medium mt-2"></p>
            </div>
            <div class="md:w-64">
              <div data-address-map-target="map" class="hidden rounded-lg overflow-hidden" style="min-height: 180px;"></div>
            </div>
          </div>
          <input type="hidden" value="<%= @lead.address_street %>" data-address-map-target="street" />
          <input type="hidden" value="<%= @lead.address_city %>" data-address-map-target="city" />
          <input type="hidden" value="<%= @lead.address_state %>" data-address-map-target="state" />
          <input type="hidden" value="<%= @lead.address_zip %>" data-address-map-target="zip" />
        </div>
      <% end %>

      <!-- UTM Data -->
      <% if @lead.utm_source.present? || @lead.utm_medium.present? %>
        <div class="mt-4 pt-4 border-t border-gray-100">
          <p class="text-gray-500 text-sm mb-2">Campaign Data</p>
          <div class="flex flex-wrap gap-2">
            <% %w[utm_source utm_medium utm_campaign utm_term utm_content].each do |field| %>
              <% if @lead.send(field).present? %>
                <span class="inline-block bg-gray-100 text-gray-600 px-2 py-1 rounded text-xs"><%= field.sub('utm_', '') %>: <%= @lead.send(field) %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Notes Section -->
    <div class="bg-white rounded-xl shadow-sm p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Notes</h2>

      <% if current_user_can?(:create, :notes) %>
        <div class="mb-6">
          <%= form_with url: admin_lead_notes_path(@lead), id: "note_form", class: "flex flex-col sm:flex-row gap-3" do |f| %>
            <%= f.text_area :body, placeholder: "Add a note...", rows: 2, class: "flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 input-admin resize-none text-sm", required: true %>
            <%= f.submit t("admin.leads.add_note"), class: "self-end px-4 py-2 bg-primary text-white rounded-lg text-sm hover:bg-primary-light transition cursor-pointer" %>
          <% end %>
        </div>
      <% end %>

      <div id="notes" class="space-y-4">
        <% @notes.each do |note| %>
          <div class="flex gap-3 p-3 rounded-lg bg-gray-50" id="<%= dom_id(note) %>">
            <div class="w-8 h-8 bg-accent rounded-full flex-shrink-0 flex items-center justify-center text-primary text-xs font-bold">
              <%= note.user.first_name[0] %><%= note.user.last_name[0] %>
            </div>
            <div class="flex-1">
              <div class="flex justify-between items-start">
                <p class="font-medium text-sm text-gray-900"><%= note.user.full_name %></p>
                <div class="flex items-center gap-2">
                  <span class="text-xs text-gray-400"><%= format_datetime(note.created_at) %></span>
                  <% if current_user.admin? || note.user == current_user %>
                    <%= render "shared/confirm_button", url: admin_lead_note_path(@lead, note), method: :delete, label: "&times;".html_safe, title: "Delete Note", message: "Delete this note? This cannot be undone.", danger: true, button_class: "text-red-400 hover:text-red-600 text-xs cursor-pointer" %>
                  <% end %>
                </div>
              </div>
              <p class="text-sm text-gray-700 mt-1 whitespace-pre-line"><%= note.body %></p>
              <% if note.note_type != "manual" %>
                <span class="inline-block mt-1 px-2 py-0.5 bg-blue-50 text-blue-600 text-xs rounded"><%= note.note_type %></span>
              <% end %>
            </div>
          </div>
        <% end %>
        <% if @notes.empty? %>
          <p class="text-gray-400 text-sm text-center py-4">No notes yet</p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Right Sidebar -->
  <div class="space-y-6">
    <!-- Create Project -->
    <% if current_user_can?(:manage, :leads) %>
      <div class="bg-white rounded-xl shadow-sm p-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-3">Convert to Project</h3>
        <% if @lead.projects.any? %>
          <div class="space-y-2 mb-3">
            <% @lead.projects.each do |project| %>
              <%= link_to admin_project_path(project), class: "block text-sm text-accent hover:text-accent-hover" do %>
                <%= project.title %> <span class="text-gray-400">(<%= project.status.titleize %>)</span>
              <% end %>
            <% end %>
          </div>
        <% end %>
        <%= link_to "Create Project", new_admin_project_path(lead_id: @lead.id), class: "btn-admin w-full text-center" %>
      </div>
    <% end %>

    <!-- Status Transition -->
    <% if current_user_can?(:manage, :leads) %>
      <div class="bg-white rounded-xl shadow-sm p-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-3">Change Status</h3>
        <div class="space-y-2">
          <% Lead.statuses.each_key do |status| %>
            <% next if status == @lead.status %>
            <%= render "shared/confirm_button", url: transition_admin_lead_path(@lead, status: status), method: :patch, label: t("admin.leads.status.#{status}"), title: "Change Status", message: "Move this lead to \"#{status.titleize}\"?", confirm_text: "Move to #{status.titleize}", button_class: "w-full text-left px-3 py-2 rounded-lg text-sm font-medium #{status_badge_color(status)} hover:opacity-80 transition cursor-pointer" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Spam Actions -->
    <% if current_user_can?(:manage, :leads) %>
      <div class="bg-white rounded-xl shadow-sm p-6">
        <h3 class="text-sm font-semibold text-gray-900 mb-3">Actions</h3>
        <% if @lead.spam? %>
          <%= button_to t("admin.leads.unmark_spam"), unmark_spam_admin_lead_path(@lead), method: :patch, class: "w-full px-3 py-2 bg-green-100 text-green-700 rounded-lg text-sm font-medium hover:bg-green-200 transition cursor-pointer" %>
        <% else %>
          <%= render "shared/confirm_button", url: mark_spam_admin_lead_path(@lead), method: :patch, label: t("admin.leads.mark_spam"), title: "Mark as Spam", message: "Mark this lead as spam? It will be moved to the spam view.", confirm_text: "Mark Spam", danger: true, button_class: "w-full text-center btn-admin-destructive" %>
        <% end %>
      </div>
    <% end %>

    <!-- Status History -->
    <div class="bg-white rounded-xl shadow-sm p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-3">Status History</h3>
      <div class="space-y-3">
        <% @status_changes.each do |change| %>
          <div class="flex items-start gap-2 text-sm">
            <div class="w-2 h-2 mt-1.5 rounded-full bg-accent flex-shrink-0"></div>
            <div>
              <p class="text-gray-700">
                <span class="font-medium"><%= change.from_status&.titleize || "New" %></span>
                &rarr;
                <span class="font-medium"><%= change.to_status.titleize %></span>
              </p>
              <p class="text-xs text-gray-400"><%= change.user&.full_name || "System" %> &middot; <%= format_datetime(change.created_at) %></p>
            </div>
          </div>
        <% end %>
        <% if @status_changes.empty? %>
          <p class="text-gray-400 text-sm">No status changes yet</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
