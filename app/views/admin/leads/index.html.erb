<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900"><%= params[:spam] == "true" ? t("admin.nav.spam") : t("admin.leads.title") %></h1>
</div>

<!-- Filters -->
<div class="bg-white rounded-xl shadow-sm p-4 mb-6">
  <div class="flex flex-wrap gap-3 items-center">
    <!-- Status filter -->
    <%= link_to t("admin.leads.filter_all"), admin_leads_path(spam: params[:spam]), class: "px-3 py-1.5 rounded-full text-sm font-medium #{params[:status].blank? ? 'bg-[#0f1b2d] text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'} transition" %>
    <% Lead.statuses.each_key do |status| %>
      <%= link_to t("admin.leads.status.#{status}"), admin_leads_path(status: status, spam: params[:spam], temperature: params[:temperature]), class: "px-3 py-1.5 rounded-full text-sm font-medium #{params[:status] == status ? 'bg-[#0f1b2d] text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'} transition" %>
    <% end %>

    <span class="text-gray-300">|</span>

    <!-- Temperature filter -->
    <% %w[hot warm cold].each do |temp| %>
      <%= link_to t("admin.leads.temperature.#{temp}"), admin_leads_path(temperature: temp, status: params[:status], spam: params[:spam]), class: "px-3 py-1.5 rounded-full text-sm font-medium #{params[:temperature] == temp ? temperature_badge_color(temp) : 'bg-gray-100 text-gray-600 hover:bg-gray-200'} transition" %>
    <% end %>

    <!-- Search -->
    <div class="ml-auto">
      <%= form_with url: admin_leads_path, method: :get, class: "flex gap-2" do |f| %>
        <%= f.hidden_field :spam, value: params[:spam] %>
        <%= f.search_field :q, value: params[:q], placeholder: "Search leads...", class: "px-3 py-1.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#d4a338] focus:border-transparent outline-none" %>
        <%= f.submit "Search", class: "px-3 py-1.5 bg-[#0f1b2d] text-white rounded-lg text-sm hover:bg-[#1b2a4a] transition cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>

<!-- Leads Table -->
<div class="bg-white rounded-xl shadow-sm overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Contact</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Service</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Temp</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Spam Score</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @leads.each do |lead| %>
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-4">
            <%= link_to admin_lead_path(lead), class: "font-medium text-gray-900 hover:text-[#d4a338]" do %>
              <%= lead.first_name %> <%= lead.last_name %>
            <% end %>
          </td>
          <td class="px-6 py-4 text-sm text-gray-500">
            <% if lead.email.present? %><p><%= lead.email %></p><% end %>
            <% if lead.phone.present? %><p><%= lead.phone %></p><% end %>
          </td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= lead.service_interested_in&.titleize %></td>
          <td class="px-6 py-4">
            <span class="inline-block px-2 py-1 rounded-full text-xs font-medium <%= status_badge_color(lead.status) %>"><%= lead.status.titleize %></span>
          </td>
          <td class="px-6 py-4">
            <% if lead.lead_temperature.present? %>
              <span class="inline-block px-2 py-1 rounded-full text-xs font-medium <%= temperature_badge_color(lead.lead_temperature) %>"><%= lead.temperature_emoji %> <%= lead.lead_temperature.capitalize %></span>
            <% end %>
          </td>
          <td class="px-6 py-4">
            <% score = lead.spam_score || 0 %>
            <div class="flex items-center gap-2">
              <div class="w-16 h-2 bg-gray-200 rounded-full overflow-hidden">
                <div class="h-full rounded-full <%= score >= 0.7 ? 'bg-red-500' : score >= 0.4 ? 'bg-yellow-500' : 'bg-green-500' %>" style="width: <%= (score * 100).round %>%"></div>
              </div>
              <span class="text-xs text-gray-500"><%= (score * 100).round %>%</span>
            </div>
          </td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= lead.created_at.strftime("%b %d, %Y") %></td>
          <td class="px-6 py-4 text-sm">
            <% if params[:spam] == "true" && current_user_can?(:manage, :leads) %>
              <%= button_to "Not Spam", unmark_spam_admin_lead_path(lead), method: :patch, class: "text-green-600 hover:text-green-800 text-xs" %>
            <% elsif current_user_can?(:manage, :leads) %>
              <%= button_to "Spam", mark_spam_admin_lead_path(lead), method: :patch, class: "text-red-600 hover:text-red-800 text-xs", data: { turbo_confirm: "Mark as spam?" } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @leads.empty? %>
    <div class="text-center py-12">
      <p class="text-gray-400"><%= t("admin.leads.no_leads") %></p>
    </div>
  <% end %>
</div>

<!-- Pagination -->
<% if @pagy && @pagy.pages > 1 %>
  <div class="mt-6 flex justify-center">
    <%== @pagy.series_nav %>
  </div>
<% end %>
