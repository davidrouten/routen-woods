<% current_view = if params[:spam] == "true"
                     :spam
                   elsif params[:archived] == "true"
                     :archived
                   elsif params[:filter] == "all"
                     :all
                   elsif params[:status].present?
                     params[:status].to_sym
                   else
                     :open
                   end %>

<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900">
    <%= case current_view
        when :spam then t("admin.nav.spam")
        when :archived then "Archived Leads"
        else t("admin.leads.title")
        end %>
  </h1>
</div>

<!-- Filters -->
<div class="bg-white rounded-xl shadow-sm p-4 mb-6">
  <div class="flex flex-wrap gap-3 items-center">
    <!-- Primary filters -->
    <%= link_to "Open", admin_leads_path, class: "px-3 py-1.5 rounded-full text-sm font-medium #{current_view == :open ? 'bg-[#0f1b2d] text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'} transition" %>
    <%= link_to "All", admin_leads_path(filter: "all"), class: "px-3 py-1.5 rounded-full text-sm font-medium #{current_view == :all ? 'bg-[#0f1b2d] text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'} transition" %>

    <span class="text-gray-300">|</span>

    <!-- Status filters -->
    <% Lead.statuses.each_key do |status| %>
      <%= link_to t("admin.leads.status.#{status}"), admin_leads_path(status: status, temperature: params[:temperature]), class: "px-3 py-1.5 rounded-full text-sm font-medium #{current_view == status.to_sym ? 'bg-[#0f1b2d] text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'} transition" %>
    <% end %>

    <span class="text-gray-300">|</span>

    <!-- Temperature filter -->
    <% %w[hot warm cold].each do |temp| %>
      <%= link_to t("admin.leads.temperature.#{temp}"), admin_leads_path(temperature: temp, status: params[:status], filter: params[:filter]), class: "px-3 py-1.5 rounded-full text-sm font-medium #{params[:temperature] == temp ? temperature_badge_color(temp) : 'bg-gray-100 text-gray-600 hover:bg-gray-200'} transition" %>
    <% end %>

    <span class="text-gray-300">|</span>

    <!-- Special views -->
    <%= link_to "Spam", admin_leads_path(spam: true), class: "px-3 py-1.5 rounded-full text-sm font-medium #{current_view == :spam ? 'bg-red-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'} transition" %>
    <%= link_to "Archived", admin_leads_path(archived: true), class: "px-3 py-1.5 rounded-full text-sm font-medium #{current_view == :archived ? 'bg-gray-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'} transition" %>

    <!-- Search -->
    <div class="ml-auto">
      <%= form_with url: admin_leads_path, method: :get, class: "flex gap-2" do |f| %>
        <%= f.search_field :q, value: params[:q], placeholder: "Search leads...", class: "px-3 py-1.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#d4a338] focus:border-transparent outline-none" %>
        <%= f.submit "Search", class: "px-3 py-1.5 bg-[#0f1b2d] text-white rounded-lg text-sm hover:bg-[#1b2a4a] transition cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>

<!-- Leads Table -->
<div class="bg-white rounded-xl shadow-sm overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Contact</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Service</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Temp</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Spam Score</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @leads.each do |lead| %>
        <%= render "admin/leads/lead_row", lead: lead, current_view: current_view %>
      <% end %>
    </tbody>
  </table>

  <% if @leads.empty? %>
    <div class="text-center py-12">
      <p class="text-gray-400"><%= t("admin.leads.no_leads") %></p>
    </div>
  <% end %>
</div>

<!-- Pagination -->
<% if @pagy && @pagy.pages > 1 %>
  <div class="mt-6 flex justify-center">
    <%== @pagy.series_nav %>
  </div>
<% end %>
