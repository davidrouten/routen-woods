<%= form_with(model: [:admin, lead], class: "space-y-6") do |f| %>
  <% if lead.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-xl p-4">
      <ul class="list-disc list-inside text-red-700 text-sm">
        <% lead.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm p-6 space-y-5"
       data-controller="customer-suggest"
       data-customer-suggest-current-id-value="<%= lead.customer_id %>"
       data-customer-suggest-current-name-value="<%= lead.customer&.full_name %>"
  >
    <h2 class="text-lg font-semibold text-gray-900">Contact Info</h2>
    <%= f.hidden_field :customer_id, data: { customer_suggest_target: "customerId" } %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <%= f.label :first_name, class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.text_field :first_name, class: "input-admin w-full", required: true %>
      </div>
      <div>
        <%= f.label :last_name, class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.text_field :last_name, class: "input-admin w-full" %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <%= f.label :email, class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.email_field :email, class: "input-admin w-full", data: { customer_suggest_target: "email", action: "blur->customer-suggest#lookup" } %>
      </div>
      <div>
        <%= f.label :phone, class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.telephone_field :phone, class: "input-admin w-full", data: { customer_suggest_target: "phone", action: "blur->customer-suggest#lookup" } %>
      </div>
    </div>

    <div data-customer-suggest-target="customerArea"></div>
  </div>

  <div class="bg-white rounded-xl shadow-sm p-6"
       data-controller="address-map"
       data-address-map-business-lat-value="<%= t('business.admin_geo.latitude') %>"
       data-address-map-business-lng-value="<%= t('business.admin_geo.longitude') %>"
       data-address-map-business-label-value="<%= t('business.address.full') %>">
    <h2 class="text-lg font-semibold text-gray-900 mb-5">Address</h2>
    <div class="flex flex-col md:flex-row gap-6">
      <div class="flex-1 space-y-5">
        <div>
          <%= f.label :address_street, "Street", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
          <%= f.text_field :address_street, class: "input-admin w-full", placeholder: "Street address", data: { address_map_target: "street", action: "input->address-map#onAddressChange" } %>
        </div>
        <div>
          <%= f.label :address_street2, "Street 2", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
          <%= f.text_field :address_street2, class: "input-admin w-full", placeholder: "Apt, suite, unit, etc." %>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <%= f.label :address_city, "City", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
            <%= f.text_field :address_city, class: "input-admin w-full", data: { address_map_target: "city", action: "input->address-map#onAddressChange" } %>
          </div>
          <div>
            <%= f.label :address_state, "State", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
            <%= f.text_field :address_state, class: "input-admin w-full", data: { address_map_target: "state", action: "input->address-map#onAddressChange" } %>
          </div>
          <div>
            <%= f.label :address_zip, "Zip", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
            <%= f.text_field :address_zip, class: "input-admin w-full", maxlength: 10, data: { address_map_target: "zip", action: "input->address-map#onAddressChange" } %>
          </div>
        </div>
      </div>
      <div class="md:w-72 flex flex-col">
        <div data-address-map-target="map" class="hidden rounded-lg overflow-hidden flex-1" style="min-height: 200px;"></div>
        <p data-address-map-target="distance" class="hidden text-sm text-gray-500 font-medium mt-2"></p>
        <p data-address-map-target="error" class="hidden text-sm text-red-500 font-medium mt-2"></p>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm p-6 space-y-5">
    <h2 class="text-lg font-semibold text-gray-900">Project Details</h2>

    <div>
      <p class="block text-sm font-semibold text-gray-700 mb-2">Services Interested In</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        <% service_checkbox_options.each do |name, key| %>
          <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
            <%= check_box_tag "lead[services_interested_in][]", key, lead.services_interested_in&.include?(key), class: "rounded border-gray-300 text-accent focus:ring-accent" %>
            <%= name %>
          </label>
        <% end %>
      </div>
      <div data-controller="other-service">
        <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
          <%= check_box_tag "other_service_toggle", "1", lead.other_service.present?, class: "rounded border-gray-300 text-accent focus:ring-accent", data: { action: "other-service#toggle", "other-service-target": "checkbox" } %>
          Other
        </label>
        <div class="mt-2 <%= 'hidden' unless lead.other_service.present? %>" data-other-service-target="field">
          <%= f.text_field :other_service, placeholder: "Please specify...", class: "input-admin w-full" %>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <%= f.label :lead_source, "Lead Source", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.select :lead_source, Lead::LEAD_SOURCES.map { |s| [s, s] }, { include_blank: "Select source..." }, class: "input-admin w-full" %>
      </div>
      <div>
        <%= f.label :lead_source_reference, "Reference #", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.text_field :lead_source_reference, class: "input-admin w-full", placeholder: "Angi lead #, referral name, etc." %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <%= f.label :budget_range, class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.select :budget_range, budget_range_options, { include_blank: "Select budget..." }, class: "input-admin w-full" %>
      </div>
      <div>
        <%= f.label :timeframe, class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.select :timeframe, timeframe_options, { include_blank: "Select timeframe..." }, class: "input-admin w-full" %>
      </div>
    </div>

    <div>
      <%= f.label :message, "Message / Notes", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
      <%= f.text_area :message, rows: 4, class: "input-admin w-full resize-none" %>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm p-6 space-y-5">
    <h2 class="text-lg font-semibold text-gray-900">Status</h2>

    <div class="max-w-xs">
      <%= f.label :status, class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
      <%= f.select :status, Lead.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "input-admin w-full" %>
    </div>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to "Cancel", admin_leads_path, class: "btn-admin-secondary" %>
    <%= f.submit (lead.persisted? ? "Update Lead" : "Create Lead"), class: "btn-admin" %>
  </div>
<% end %>
