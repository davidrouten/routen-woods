<h1 class="text-2xl font-bold text-gray-900 mb-6">My Account</h1>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="bg-white rounded-xl shadow-sm p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Account Info</h2>
    <div class="space-y-3 text-sm">
      <div>
        <p class="text-gray-500">Name</p>
        <p class="font-medium"><%= current_user.full_name %></p>
      </div>
      <div>
        <p class="text-gray-500">Email</p>
        <p class="font-medium"><%= current_user.email %></p>
      </div>
      <div>
        <p class="text-gray-500">Role</p>
        <p class="font-medium"><%= current_user.admin? ? "Admin" : "Member" %></p>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Change Password</h2>
    <%= form_with url: admin_account_path, method: :patch, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :current_password, "Current Password", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.password_field :current_password, class: "input-admin w-full", required: true, autocomplete: "current-password" %>
      </div>
      <div>
        <%= f.label :new_password, "New Password", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.password_field :new_password, class: "input-admin w-full", required: true, minlength: 6, autocomplete: "new-password" %>
      </div>
      <div>
        <%= f.label :new_password_confirmation, "Confirm New Password", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.password_field :new_password_confirmation, class: "input-admin w-full", required: true, autocomplete: "new-password" %>
      </div>
      <div class="flex justify-end">
        <%= f.submit "Update Password", class: "btn-admin" %>
      </div>
    <% end %>
  </div>
</div>
