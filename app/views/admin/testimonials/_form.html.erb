<div class="bg-white rounded-xl shadow-sm p-6 max-w-2xl">
  <%= form_with model: [:admin, testimonial], class: "space-y-6" do |f| %>
    <% if testimonial.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <ul class="list-disc list-inside text-red-700 text-sm">
          <% testimonial.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :author_name, "Author Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :author_name, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#d4a338] focus:border-transparent outline-none", required: true %>
    </div>

    <div>
      <%= f.label :author_title, "Author Title", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :author_title, placeholder: "e.g. Homeowner, Tampa FL", class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#d4a338] focus:border-transparent outline-none" %>
    </div>

    <div>
      <%= f.label :body, "Testimonial", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :body, rows: 4, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#d4a338] focus:border-transparent outline-none resize-none", required: true %>
    </div>

    <div class="grid grid-cols-3 gap-4">
      <div>
        <%= f.label :rating, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :rating, (1..5).to_a.reverse, {}, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#d4a338] focus:border-transparent outline-none" %>
      </div>
      <div>
        <%= f.label :position, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :position, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#d4a338] focus:border-transparent outline-none" %>
      </div>
      <div class="flex items-end pb-1">
        <label class="flex items-center gap-2">
          <%= f.check_box :featured, class: "rounded text-[#d4a338] focus:ring-[#d4a338]" %>
          <span class="text-sm text-gray-700">Featured</span>
        </label>
      </div>
    </div>

    <div class="flex gap-3">
      <%= f.submit class: "px-6 py-2 bg-[#d4a338] text-[#0f1b2d] font-semibold rounded-lg hover:bg-[#b8860b] transition cursor-pointer" %>
      <%= link_to "Cancel", admin_testimonials_path, class: "px-6 py-2 bg-gray-100 text-gray-600 rounded-lg hover:bg-gray-200 transition" %>
    </div>
  <% end %>
</div>
