<div class="bg-white rounded-xl shadow-sm p-6 max-w-2xl">
  <%= form_with model: [:admin, testimonial], class: "space-y-6" do |f| %>
    <% if testimonial.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <ul class="list-disc list-inside text-red-700 text-sm">
          <% testimonial.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :author_name, "Author Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :author_name, class: "input-admin", required: true %>
    </div>

    <div>
      <%= f.label :author_title, "Author Title", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :author_title, placeholder: "e.g. Homeowner, Oxford MI", class: "input-admin" %>
    </div>

    <div>
      <%= f.label :body, "Testimonial", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :body, rows: 4, class: "input-admin resize-none", required: true %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <%= f.label :rating, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :rating, (1..5).to_a.reverse, {}, class: "input-admin" %>
      </div>
      <div>
        <%= f.label :position, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :position, class: "input-admin" %>
      </div>
      <div class="flex items-end pb-1">
        <label class="flex items-center gap-2">
          <%= f.check_box :featured, class: "rounded text-accent focus:ring-accent" %>
          <span class="text-sm text-gray-700">Featured</span>
        </label>
      </div>
    </div>

    <div class="flex justify-end gap-3">
      <%= link_to "Cancel", admin_testimonials_path, class: "btn-admin-secondary" %>
      <%= f.submit (testimonial.persisted? ? "Update Testimonial" : "Create Testimonial"), class: "btn-admin" %>
    </div>
  <% end %>
</div>
