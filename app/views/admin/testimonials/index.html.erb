<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900"><%= t("admin.nav.testimonials") %></h1>
  <% if current_user_can?(:manage, :testimonials) %>
    <%= link_to "Add Testimonial", new_admin_testimonial_path, class: "btn-admin" %>
  <% end %>
</div>

<div class="bg-white rounded-xl shadow-sm overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-2 text-left text-xs font-medium text-gray-500 uppercase">Author</th>
        <th class="px-6 py-2 text-left text-xs font-medium text-gray-500 uppercase">Rating</th>
        <th class="px-6 py-2 text-left text-xs font-medium text-gray-500 uppercase">Featured</th>
        <th class="px-6 py-2 text-left text-xs font-medium text-gray-500 uppercase">Position</th>
        <th class="px-6 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @testimonials.each do |t| %>
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-2">
            <p class="font-medium text-gray-900"><%= t.author_name %></p>
            <p class="text-sm text-gray-500 truncate max-w-xs"><%= truncate(t.body, length: 80) %></p>
          </td>
          <td class="px-6 py-2 text-accent"><%= "★" * t.rating %></td>
          <td class="px-6 py-2"><%= t.featured? ? "✓" : "—" %></td>
          <td class="px-6 py-2 text-gray-500"><%= t.position %></td>
          <td class="px-6 py-2">
            <% if current_user_can?(:manage, :testimonials) %>
              <div class="flex justify-end">
                <div class="icon-btn-group">
                  <%= link_to edit_admin_testimonial_path(t), class: "icon-btn", title: "Edit" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                  <% end %>
                  <%= button_to admin_testimonial_path(t), method: :delete, form_class: "contents", class: "icon-btn-destructive", title: "Delete", data: { turbo_confirm: "Delete testimonial from \"#{t.author_name}\"? This cannot be undone." } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                  <% end %>
                </div>
              </div>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
