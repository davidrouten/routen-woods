<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Customers</h1>
</div>

<div class="bg-white rounded-xl shadow-sm p-4 mb-6">
  <%= form_tag admin_customers_path, method: :get, class: "flex items-center gap-3" do %>
    <input type="text" name="q" value="<%= params[:q] %>" placeholder="Search customers..." class="input-admin flex-1" autofocus>
    <button type="submit" class="btn-admin">Search</button>
    <% if params[:q].present? %>
      <%= link_to "Clear", admin_customers_path, class: "btn-admin-secondary" %>
    <% end %>
  <% end %>
</div>

<div class="bg-white rounded-xl shadow-sm overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= sort_link("Name", :name, page_default: true) %></th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= sort_link("Email", :email) %></th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= sort_link("Phone", :phone) %></th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase"><%= sort_link("Leads", :leads, default_desc: true) %></th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase"><%= sort_link("Projects", :projects, default_desc: true) %></th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase"><%= sort_link("Revenue", :revenue, default_desc: true) %></th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @customers.each do |customer| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4">
              <%= link_to customer.full_name, admin_customer_path(customer), class: "font-medium text-gray-900 hover:text-accent" %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= customer.email %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= format_phone(customer.phone) %></td>
            <td class="px-6 py-4 text-sm text-center text-gray-500"><%= customer.lead_count %></td>
            <td class="px-6 py-4 text-sm text-center text-gray-500"><%= customer.project_count %></td>
            <td class="px-6 py-4 text-sm text-right font-medium text-gray-700"><%= number_to_currency(customer.total_revenue, precision: 0) %></td>
            <td class="px-6 py-4">
              <div class="flex justify-end">
                <div class="icon-btn-group">
                  <%= link_to edit_admin_customer_path(customer), class: "icon-btn", title: "Edit" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                  <% end %>
                </div>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @customers.empty? %>
    <div class="px-4 py-8 text-center text-gray-400">
      <p>No customers found.</p>
    </div>
  <% end %>
</div>

<% if @pagy && @pagy.pages > 1 %>
  <div class="mt-6 flex justify-center">
    <%== @pagy.series_nav %>
  </div>
<% end %>
