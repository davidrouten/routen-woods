<div class="mb-6">
  <%= link_to "&larr; Back to Customers".html_safe, admin_customers_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Main Content -->
  <div class="lg:col-span-2 space-y-6">
    <!-- Header Card -->
    <div class="bg-white rounded-xl shadow-sm p-6">
      <div class="flex justify-between items-start mb-4">
        <div>
          <h1 class="text-2xl font-bold text-gray-900"><%= @customer.full_name %></h1>
        </div>
        <%= link_to "Edit", edit_admin_customer_path(@customer), class: "btn-admin-secondary" %>
      </div>

      <div class="grid grid-cols-2 gap-4 text-sm">
        <% if @customer.email.present? %>
          <div>
            <p class="text-gray-500">Email</p>
            <p class="font-medium"><%= mail_to @customer.email, @customer.email, class: "text-accent hover:text-accent-hover" %></p>
          </div>
        <% end %>
        <% if @customer.phone.present? %>
          <div>
            <p class="text-gray-500">Phone</p>
            <p class="font-medium"><%= link_to @customer.phone, "tel:#{@customer.phone}", class: "text-accent hover:text-accent-hover" %></p>
          </div>
        <% end %>
        <% if @customer.address_street.present? %>
          <div class="col-span-2">
            <p class="text-gray-500">Address</p>
            <p class="font-medium"><%= [@customer.address_street, @customer.address_street2, @customer.address_city, @customer.address_state, @customer.address_zip].compact_blank.join(", ") %></p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl shadow-sm p-4">
        <p class="text-xs text-gray-500">Lifetime Revenue</p>
        <p class="text-lg font-bold text-gray-900"><%= number_to_currency(@customer.total_revenue, precision: 0) %></p>
      </div>
      <div class="bg-white rounded-xl shadow-sm p-4">
        <p class="text-xs text-gray-500">Total Collected</p>
        <p class="text-lg font-bold text-emerald-700"><%= number_to_currency(@customer.total_collected, precision: 0) %></p>
      </div>
      <div class="bg-white rounded-xl shadow-sm p-4">
        <p class="text-xs text-gray-500">Leads</p>
        <p class="text-lg font-bold text-gray-900"><%= @leads.size %></p>
      </div>
      <div class="bg-white rounded-xl shadow-sm p-4">
        <p class="text-xs text-gray-500">Projects</p>
        <p class="text-lg font-bold text-gray-900"><%= @projects.size %></p>
      </div>
    </div>

    <!-- Leads -->
    <% if @leads.any? %>
      <div class="bg-white rounded-xl shadow-sm p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Leads</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="text-left px-3 py-2 font-semibold text-gray-700">Name</th>
                <th class="text-left px-3 py-2 font-semibold text-gray-700">Status</th>
                <th class="text-left px-3 py-2 font-semibold text-gray-700">Services</th>
                <th class="text-left px-3 py-2 font-semibold text-gray-700">Date</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @leads.each do |lead| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-3 py-2"><%= link_to lead.full_name_or_email, admin_lead_path(lead), class: "text-accent hover:text-accent-hover font-medium" %></td>
                  <td class="px-3 py-2"><span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium <%= status_badge_color(lead.status) %>"><%= lead.status.titleize %></span></td>
                  <td class="px-3 py-2 text-gray-600 truncate max-w-[200px]"><%= lead.service_names %></td>
                  <td class="px-3 py-2 text-gray-500"><%= lead.created_at.strftime("%b %d, %Y") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <!-- Projects -->
    <% if @projects.any? %>
      <div class="bg-white rounded-xl shadow-sm p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Projects</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="text-left px-3 py-2 font-semibold text-gray-700">Title</th>
                <th class="text-left px-3 py-2 font-semibold text-gray-700">Status</th>
                <th class="text-right px-3 py-2 font-semibold text-gray-700">Agreed Price</th>
                <th class="text-left px-3 py-2 font-semibold text-gray-700">Date</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @projects.each do |project| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-3 py-2"><%= link_to project.title, admin_project_path(project), class: "text-accent hover:text-accent-hover font-medium" %></td>
                  <td class="px-3 py-2"><span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium <%= project_status_color(project.status) %>"><%= project.status.titleize %></span></td>
                  <td class="px-3 py-2 text-right font-medium text-gray-900"><%= number_to_currency(project.agreed_price) if project.agreed_price %></td>
                  <td class="px-3 py-2 text-gray-500"><%= project.created_at.strftime("%b %d, %Y") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <!-- Invoices -->
    <% if @invoices.any? %>
      <div class="bg-white rounded-xl shadow-sm p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Invoices</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="text-left px-3 py-2 font-semibold text-gray-700">Invoice #</th>
                <th class="text-left px-3 py-2 font-semibold text-gray-700">Status</th>
                <th class="text-right px-3 py-2 font-semibold text-gray-700">Total</th>
                <th class="text-right px-3 py-2 font-semibold text-gray-700">Paid</th>
                <th class="text-left px-3 py-2 font-semibold text-gray-700">Date</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @invoices.each do |invoice| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-3 py-2"><%= link_to invoice.invoice_number, admin_invoice_path(invoice), class: "text-accent hover:text-accent-hover font-medium" %></td>
                  <td class="px-3 py-2"><span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium <%= status_badge_color(invoice.status) %>"><%= invoice.status.titleize %></span></td>
                  <td class="px-3 py-2 text-right font-medium text-gray-900"><%= number_to_currency(invoice.total) %></td>
                  <td class="px-3 py-2 text-right text-gray-600"><%= number_to_currency(invoice.amount_paid) %></td>
                  <td class="px-3 py-2 text-gray-500"><%= invoice.created_at.strftime("%b %d, %Y") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Sidebar -->
  <div class="space-y-6">
    <div class="bg-white rounded-xl shadow-sm p-6">
      <h3 class="text-sm font-semibold text-gray-700 mb-3">Customer Since</h3>
      <p class="text-gray-900"><%= @customer.created_at.strftime("%B %d, %Y") %></p>
    </div>
  </div>
</div>
