<div class="bg-white rounded-xl shadow-sm p-6 max-w-2xl">
  <%= form_with model: [:admin, gallery_image], class: "space-y-6" do |f| %>
    <% if gallery_image.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <ul class="list-disc list-inside text-red-700 text-sm">
          <% gallery_image.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :title, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :title, class: "input-admin", required: true %>
    </div>

    <div>
      <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 3, class: "input-admin resize-none" %>
    </div>

    <div>
      <%= f.label :image, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.file_field :image, accept: "image/*", class: "w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-accent file:text-primary hover:file:bg-accent-hover" %>
    </div>

    <div>
      <p class="block text-sm font-medium text-gray-700 mb-2">Show on Pages</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
        <% GalleryImage::PAGE_TAGS.each do |tag, label|
             service = I18n.t("business.services.#{tag}", default: nil)
             next if service.is_a?(Hash) && !service[:enabled]
           %>
          <label class="flex items-center gap-2 px-3 py-2 rounded-lg border border-gray-200 hover:border-accent/30 transition cursor-pointer text-sm">
            <input type="checkbox" name="gallery_image[page_tags][]" value="<%= tag %>"
                   <%= "checked" if gallery_image.page_tags&.include?(tag) || (gallery_image.new_record? && tag == GalleryImage::TAG_GALLERY) %>
                   class="rounded text-accent focus:ring-accent" />
            <span class="text-gray-700"><%= label %></span>
          </label>
        <% end %>
      </div>
      <%# Ensure empty array is submitted when nothing checked %>
      <input type="hidden" name="gallery_image[page_tags][]" value="" />
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :position, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :position, class: "input-admin" %>
      </div>
      <%# Featured checkbox hidden — position controls display order for now %>
    </div>

    <div class="flex justify-end gap-3">
      <%= link_to "Cancel", admin_gallery_images_path, class: "btn-admin-secondary" %>
      <%= f.submit (gallery_image.persisted? ? "Update Image" : "Upload Image"), class: "btn-admin" %>
    </div>
  <% end %>
</div>
