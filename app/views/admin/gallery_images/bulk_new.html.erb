<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Gallery", admin_gallery_images_path, class: "text-sm text-gray-500 hover:text-accent transition" %>
  </div>

  <h1 class="text-2xl font-extrabold text-primary mb-8">Bulk Upload Images</h1>

  <form action="<%= bulk_create_admin_gallery_images_path %>"
        method="post"
        enctype="multipart/form-data"
        data-controller="bulk-upload"
        data-bulk-upload-tags-value="<%= GalleryImage::PAGE_TAGS.reject { |tag, _| svc = I18n.t("business.services.#{tag}", default: nil); svc.is_a?(Hash) && !svc[:enabled] }.to_a.to_json %>"
        data-success-url="<%= admin_gallery_images_path %>"
        data-action="submit->bulk-upload#submit">

    <!-- Drop zone -->
    <div data-bulk-upload-target="dropzone"
         data-action="dragover->bulk-upload#dragover dragleave->bulk-upload#dragleave drop->bulk-upload#drop click->bulk-upload#browse"
         class="border-2 border-dashed border-gray-300 rounded-2xl p-12 text-center cursor-pointer hover:border-accent transition-colors duration-200 mb-8">

      <div class="flex flex-col items-center gap-3">
        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <p class="text-gray-500 text-lg font-medium">Drag & drop images here</p>
        <p class="text-gray-400 text-sm">or click to browse</p>
      </div>

      <input type="file" multiple accept="image/*"
             data-bulk-upload-target="fileInput"
             data-action="change->bulk-upload#selectFiles"
             class="hidden" />
    </div>

    <!-- Image cards -->
    <div data-bulk-upload-target="rows" class="space-y-4 mb-8"></div>

    <!-- Empty state -->
    <div data-bulk-upload-target="emptyState" class="text-center text-gray-400 py-8">
      Drop images above to get started
    </div>

    <!-- Submit -->
    <div class="flex justify-end">
      <button type="submit"
              data-bulk-upload-target="submitBtn"
              class="hidden btn-primary">
        Upload All
      </button>
    </div>
  </form>
</div>
