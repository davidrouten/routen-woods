<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900"><%= t("admin.nav.gallery") %></h1>
  <% if current_user_can?(:manage, :gallery) %>
    <div class="flex items-center gap-3">
      <%= link_to "Bulk Upload", bulk_new_admin_gallery_images_path, class: "btn-admin-secondary" %>
      <%= link_to "Add Image", new_admin_gallery_image_path, class: "btn-admin" %>
    </div>
  <% end %>
</div>

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
  <% @gallery_images.each do |image| %>
    <div class="bg-white rounded-xl shadow-sm overflow-hidden">
      <div class="aspect-square bg-gray-100 flex items-center justify-center">
        <% if image.image.attached? %>
          <%= image_tag image.image.variant(resize_to_limit: [400, 400], format: :webp),
              class: "w-full h-full object-cover", loading: "lazy", decoding: "async" %>
        <% else %>
          <svg class="w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        <% end %>
      </div>
      <div class="p-3">
        <p class="font-medium text-sm text-gray-900 truncate"><%= image.title %></p>
        <%# Featured badge hidden — position controls display order for now %>
        <% if current_user_can?(:manage, :gallery) %>
          <div class="flex gap-2 mt-2">
            <div class="icon-btn-group">
              <%= link_to edit_admin_gallery_image_path(image), class: "icon-btn", title: "Edit" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
              <% end %>
              <%= button_to admin_gallery_image_path(image), method: :delete, form_class: "contents", class: "icon-btn-destructive", title: "Delete", data: { turbo_confirm: "Delete \"#{image.title}\"? This cannot be undone." } do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
