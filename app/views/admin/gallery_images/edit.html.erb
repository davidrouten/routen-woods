<div class="mb-6">
  <%= link_to "&larr; Back to Gallery".html_safe, admin_gallery_images_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
</div>

<h1 class="text-2xl font-bold text-gray-900 mb-6">Edit Image</h1>

<div class="flex flex-col lg:flex-row gap-6">
  <div class="lg:w-1/2">
    <%= render "form", gallery_image: @gallery_image %>
  </div>

  <% if @gallery_image.image.attached? %>
    <div class="lg:w-1/2">
      <div class="bg-white rounded-xl shadow-sm p-4 sticky top-6">
        <%= image_tag @gallery_image.image.variant(resize_to_limit: [800, 800], format: :webp),
            class: "rounded-lg w-full h-auto" %>
      </div>
    </div>
  <% end %>
</div>
