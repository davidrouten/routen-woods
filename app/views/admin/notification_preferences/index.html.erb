<h1 class="text-2xl font-bold text-gray-900 mb-6"><%= t("admin.nav.settings") %> — Notifications</h1>

<div class="bg-white rounded-xl shadow-sm overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Event</th>
        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Email</th>
        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">SMS</th>
        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Slack</th>
        <th class="px-6 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @preferences.each do |pref| %>
        <tr>
          <%= form_with model: [:admin, pref], class: "contents" do |f| %>
            <td class="px-6 py-4 font-medium text-gray-900"><%= pref.event_name.titleize %></td>
            <td class="px-6 py-4 text-center"><%= f.check_box :email_enabled, class: "rounded text-accent focus:ring-accent" %></td>
            <td class="px-6 py-4 text-center"><%= f.check_box :sms_enabled, class: "rounded text-accent focus:ring-accent" %></td>
            <td class="px-6 py-4 text-center"><%= f.check_box :slack_enabled, class: "rounded text-accent focus:ring-accent" %></td>
            <td class="px-6 py-4 text-right"><%= f.submit "Save", class: "px-3 py-1 bg-primary text-white rounded text-sm hover:bg-primary-light transition cursor-pointer" %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
