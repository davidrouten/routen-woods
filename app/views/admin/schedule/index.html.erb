<div class="flex flex-col lg:flex-row gap-6"
     data-controller="schedule-calendar"
     data-schedule-calendar-projects-value="<%= @scheduled_projects.to_json %>"
     data-schedule-calendar-unscheduled-value="<%= @unscheduled_projects.to_json %>">

  <!-- Main calendar area -->
  <div class="flex-1 min-w-0">
    <!-- Header: title + nav + tabs -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
      <h1 class="text-2xl font-bold text-gray-900">Schedule</h1>

      <div class="flex items-center gap-3">
        <!-- Navigation -->
        <div class="flex items-center gap-1 shrink-0">
          <button data-action="schedule-calendar#prev"
                  class="w-9 h-9 flex items-center justify-center rounded-lg text-gray-600 hover:bg-gray-200 transition"
                  title="Previous">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button data-action="schedule-calendar#today"
                  class="w-16 h-9 flex items-center justify-center text-sm font-medium rounded-lg text-gray-700 hover:bg-gray-200 transition">
            Today
          </button>
          <button data-action="schedule-calendar#next"
                  class="w-9 h-9 flex items-center justify-center rounded-lg text-gray-600 hover:bg-gray-200 transition"
                  title="Next">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>

        <span class="text-sm font-medium text-gray-700 w-48 text-center shrink-0" data-schedule-calendar-target="dateLabel"></span>

        <!-- Tabs -->
        <div class="flex bg-gray-100 rounded-lg p-0.5 shrink-0">
          <button data-action="schedule-calendar#switchToWeek"
                  data-schedule-calendar-target="weekTab"
                  class="px-3 py-1.5 text-sm font-medium rounded-md transition">
            Week
          </button>
          <button data-action="schedule-calendar#switchToEightWeek"
                  data-schedule-calendar-target="eightWeekTab"
                  class="px-3 py-1.5 text-sm font-medium rounded-md transition">
            8-Week
          </button>
        </div>
      </div>
    </div>

    <!-- Status filter -->
    <div class="flex items-center gap-2 mb-4">
      <label class="flex items-center gap-1.5 text-sm text-gray-600 cursor-pointer">
        <input type="checkbox" data-action="schedule-calendar#toggleCompleted"
               data-schedule-calendar-target="completedToggle"
               class="rounded border-gray-300 text-accent focus:ring-accent/30">
        Show completed/paid
      </label>
    </div>

    <!-- Calendar grid rendered by Stimulus -->
    <div class="bg-white rounded-xl shadow-sm overflow-hidden"
         data-schedule-calendar-target="grid">
    </div>

    <!-- Project key rendered by Stimulus -->
    <div data-schedule-calendar-target="projectKey"></div>
  </div>

  <!-- Unscheduled sidebar -->
  <div class="lg:w-64 shrink-0" data-schedule-calendar-target="unscheduledPanel">
    <div class="bg-white rounded-xl shadow-sm p-4">
      <h3 class="text-sm font-semibold text-gray-900 mb-3">Unscheduled Projects</h3>
      <div class="space-y-2" data-schedule-calendar-target="unscheduledList">
        <% if @unscheduled_projects.empty? %>
          <p class="text-sm text-gray-400">All projects are scheduled</p>
        <% else %>
          <% @unscheduled_projects.each do |project| %>
            <%= link_to project[:url], class: "block p-2 rounded-lg hover:bg-gray-50 transition" do %>
              <p class="text-sm font-medium text-gray-900 truncate"><%= project[:title] %></p>
              <% if project[:customer_name].present? %>
                <p class="text-xs text-gray-500 truncate"><%= project[:customer_name] %></p>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
