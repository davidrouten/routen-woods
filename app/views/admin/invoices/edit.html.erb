<div class="mb-6">
  <% if @project %>
    <%= link_to "&larr; Back to Invoice".html_safe, admin_project_invoice_path(@project, @invoice), class: "text-sm text-gray-500 hover:text-gray-700" %>
  <% else %>
    <%= link_to "&larr; Back to Invoice".html_safe, admin_invoice_path(@invoice), class: "text-sm text-gray-500 hover:text-gray-700" %>
  <% end %>
</div>

<h1 class="text-2xl font-bold text-gray-900 mb-6">Edit Invoice <%= @invoice.invoice_number %></h1>

<%= render "form", invoice: @invoice, project: @project %>
