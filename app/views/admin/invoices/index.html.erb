<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Invoices</h1>
  <%= link_to "New Invoice", new_admin_invoice_path, class: "btn-admin" %>
</div>

<!-- Filters -->
<div class="bg-white rounded-xl shadow-sm p-4 mb-6">
  <div class="flex flex-wrap gap-3 items-center">
    <%= link_to "All", admin_invoices_path, class: "px-3 py-1.5 rounded-full text-sm font-medium #{params[:status].blank? ? 'bg-primary text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'} transition" %>
    <% Invoice.statuses.each_key do |status| %>
      <%= link_to status.titleize, admin_invoices_path(status: status), class: "px-3 py-1.5 rounded-full text-sm font-medium #{params[:status] == status ? 'bg-primary text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'} transition" %>
    <% end %>
  </div>
</div>

<div class="bg-white rounded-xl shadow-sm overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-2 text-left text-xs font-medium text-gray-500 uppercase">Invoice #</th>
        <th class="px-6 py-2 text-left text-xs font-medium text-gray-500 uppercase">Project</th>
        <th class="px-6 py-2 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
        <th class="px-6 py-2 text-right text-xs font-medium text-gray-500 uppercase">Total</th>
        <th class="px-6 py-2 text-right text-xs font-medium text-gray-500 uppercase">Balance Due</th>
        <th class="px-6 py-2 text-left text-xs font-medium text-gray-500 uppercase">Issued</th>
        <th class="px-6 py-2 text-left text-xs font-medium text-gray-500 uppercase">Due</th>
        <th class="px-6 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @invoices.each do |invoice| %>
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-2 whitespace-nowrap">
            <%= link_to (invoice.project ? admin_project_invoice_path(invoice.project, invoice) : admin_invoice_path(invoice)), class: "font-medium text-gray-900 hover:text-accent" do %>
              <%= invoice.invoice_number %>
            <% end %>
          </td>
          <td class="px-6 py-2 text-sm text-gray-500 max-w-xs">
            <% if invoice.project %>
              <%= link_to invoice.project.title, admin_project_path(invoice.project), class: "hover:text-accent truncate block" %>
            <% else %>
              <span class="text-gray-400">—</span>
            <% end %>
          </td>
          <td class="px-6 py-2 whitespace-nowrap">
            <span class="inline-block px-2 py-1 rounded-full text-xs font-medium <%= invoice_status_color(invoice.status) %>"><%= invoice.status.titleize %></span>
          </td>
          <td class="px-6 py-2 text-sm text-right text-gray-700"><%= number_to_currency(invoice.total) %></td>
          <td class="px-6 py-2 text-sm text-right text-gray-700"><%= number_to_currency(invoice.balance_due) %></td>
          <td class="px-6 py-2 text-sm text-gray-500"><%= format_date(invoice.issued_date) %></td>
          <td class="px-6 py-2 text-sm text-gray-500"><%= format_date(invoice.due_date) %></td>
          <td class="px-6 py-2">
            <div class="flex justify-end">
              <div class="icon-btn-group">
                <%= link_to edit_admin_invoice_path(invoice), class: "icon-btn", title: "Edit" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                <% end %>
                <%= button_to admin_invoice_path(invoice), method: :delete, form_class: "contents", class: "icon-btn-destructive", title: "Delete", data: { turbo_confirm: "Delete this invoice?" } do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                <% end %>
              </div>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @invoices.empty? %>
    <div class="text-center py-12">
      <p class="text-gray-400">No invoices yet.</p>
    </div>
  <% end %>
</div>
