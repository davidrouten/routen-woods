<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Invoices</h1>
  <%= link_to "New Invoice", new_admin_invoice_path, class: "btn-admin" %>
</div>

<!-- Filters -->
<div class="bg-white rounded-xl shadow-sm p-4 mb-6">
  <div class="flex flex-wrap gap-3 items-center">
    <%= link_to "All", admin_invoices_path, class: "px-3 py-1.5 rounded-full text-sm font-medium #{params[:status].blank? ? 'bg-primary text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'} transition" %>
    <% Invoice.statuses.each_key do |status| %>
      <%= link_to status.titleize, admin_invoices_path(status: status), class: "px-3 py-1.5 rounded-full text-sm font-medium #{params[:status] == status ? 'bg-primary text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'} transition" %>
    <% end %>
  </div>
</div>

<div class="bg-white rounded-xl shadow-sm overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Invoice #</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Project</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Total</th>
        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Balance Due</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Issued</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Due</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @invoices.each do |invoice| %>
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-4">
            <%= link_to (invoice.project ? admin_project_invoice_path(invoice.project, invoice) : admin_invoice_path(invoice)), class: "font-medium text-gray-900 hover:text-accent" do %>
              <%= invoice.invoice_number %>
            <% end %>
          </td>
          <td class="px-6 py-4 text-sm text-gray-500">
            <% if invoice.project %>
              <%= link_to invoice.project.title, admin_project_path(invoice.project), class: "hover:text-accent" %>
            <% else %>
              <span class="text-gray-400">—</span>
            <% end %>
          </td>
          <td class="px-6 py-4">
            <span class="inline-block px-2 py-1 rounded-full text-xs font-medium <%= invoice_status_color(invoice.status) %>"><%= invoice.status.titleize %></span>
          </td>
          <td class="px-6 py-4 text-sm text-right text-gray-700"><%= number_to_currency(invoice.total) %></td>
          <td class="px-6 py-4 text-sm text-right text-gray-700"><%= number_to_currency(invoice.balance_due) %></td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= invoice.issued_date&.strftime("%b %d, %Y") %></td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= invoice.due_date&.strftime("%b %d, %Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @invoices.empty? %>
    <div class="text-center py-12">
      <p class="text-gray-400">No invoices yet.</p>
    </div>
  <% end %>
</div>
