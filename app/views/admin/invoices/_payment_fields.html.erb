<div class="nested-form-item flex flex-wrap gap-3 items-end mb-3 p-3 border border-gray-200 rounded-lg" data-nested-form-target="item">
  <div class="w-28">
    <%= f.label :amount, class: "block text-xs font-medium text-gray-600 mb-1" %>
    <%= f.number_field :amount, step: 0.01, min: 0, class: "input-admin w-full text-sm", required: true %>
  </div>
  <div class="w-36">
    <%= f.label :paid_at, "Date Paid", class: "block text-xs font-medium text-gray-600 mb-1" %>
    <%= f.text_field :paid_at, class: "input-admin w-full text-sm", required: true, value: (f.object.paid_at&.to_date || Date.current).iso8601, data: { controller: "flatpickr" } %>
  </div>
  <div class="w-32">
    <%= f.label :payment_method, "Method", class: "block text-xs font-medium text-gray-600 mb-1" %>
    <%= f.select :payment_method, [["Cash", "cash"], ["Check", "check"], ["Credit Card", "credit_card"], ["Bank Transfer", "bank_transfer"], ["Venmo", "venmo"], ["Zelle", "zelle"], ["Other", "other"]], { include_blank: "—" }, class: "input-admin w-full text-sm" %>
  </div>
  <div class="w-28">
    <%= f.label :reference_number, "Ref #", class: "block text-xs font-medium text-gray-600 mb-1" %>
    <%= f.text_field :reference_number, class: "input-admin w-full text-sm", placeholder: "Check #" %>
  </div>
  <div class="flex-1 min-w-[120px]">
    <%= f.label :notes, class: "block text-xs font-medium text-gray-600 mb-1" %>
    <%= f.text_field :notes, class: "input-admin w-full text-sm", placeholder: "Optional notes" %>
  </div>
  <div class="flex items-center gap-1 mb-1">
    <%= f.check_box :deposit, class: "rounded border-gray-300 text-accent focus:ring-accent" %>
    <%= f.label :deposit, "Deposit", class: "text-xs font-medium text-gray-600" %>
  </div>
  <div class="flex items-end pb-1">
    <button type="button" data-action="nested-form#remove" class="icon-btn-destructive cursor-pointer" title="Remove">
      <% if f.object.persisted? %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
      <% else %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      <% end %>
    </button>
    <%= f.hidden_field :_destroy, value: "0", data: { "nested-form-target": "destroy" } %>
  </div>
</div>
