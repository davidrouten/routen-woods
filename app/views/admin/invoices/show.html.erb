<div class="mb-6">
  <% if @invoice.project %>
    <%= link_to "&larr; Back to Project".html_safe, admin_project_path(@invoice.project), class: "text-sm text-gray-500 hover:text-gray-700" %>
  <% else %>
    <%= link_to "&larr; Back to Invoices".html_safe, admin_invoices_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  <% end %>
</div>

<div class="bg-white rounded-xl shadow-sm p-6 mb-6">
  <div class="flex justify-between items-start mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Invoice <%= @invoice.invoice_number %></h1>
      <% if @invoice.project %>
        <p class="text-gray-500 text-sm">Project: <%= link_to @invoice.project.title, admin_project_path(@invoice.project), class: "text-accent hover:text-accent-hover" %></p>
      <% end %>
    </div>
    <span class="inline-block px-3 py-1 rounded-full text-sm font-medium <%= invoice_status_color(@invoice.status) %>"><%= @invoice.status.titleize %></span>
  </div>

  <!-- Invoice Meta -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm mb-6">
    <div>
      <p class="text-gray-500">Issued</p>
      <p class="font-medium"><%= format_date(@invoice.issued_date) %></p>
    </div>
    <div>
      <p class="text-gray-500">Due</p>
      <p class="font-medium"><%= format_date(@invoice.due_date) %></p>
    </div>
    <div>
      <p class="text-gray-500">Deposit</p>
      <p class="font-medium">
        <%= @invoice.deposit_amount ? number_to_currency(@invoice.deposit_amount) : "—" %>
        <% if @invoice.deposit_paid? %><span class="text-green-600 text-xs ml-1">Paid</span><% end %>
      </p>
    </div>
    <div>
      <p class="text-gray-500">Balance Due</p>
      <p class="font-medium text-lg <%= @invoice.balance_due <= 0 ? 'text-green-700' : 'text-gray-900' %>"><%= number_to_currency(@invoice.balance_due) %></p>
    </div>
  </div>

  <!-- Actions -->
  <div class="flex gap-2 mb-6">
    <% if @invoice.draft? %>
      <%= button_to "Mark Sent", send_invoice_admin_invoice_path(@invoice), method: :patch, class: "btn-admin" %>
    <% end %>
    <button type="button"
      data-action="modal#openContent"
      data-modal-target="#record-payment-template"
      data-modal-size="lg"
      class="btn-admin cursor-pointer">
      Record Payment
    </button>
    <%= link_to "Edit", edit_admin_invoice_path(@invoice), class: "btn-admin-secondary" %>
    <%= link_to "Preview PDF", pdf_admin_invoice_path(@invoice), target: "_blank", class: "btn-admin-secondary" %>
    <%= link_to "Download PDF", pdf_admin_invoice_path(@invoice, download: true), class: "btn-admin-secondary" %>
  </div>

  <!-- Line Items -->
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Item</th>
          <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
          <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Qty</th>
          <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Unit Price</th>
          <th class="px-4 py-2 text-center text-xs font-medium text-gray-500 uppercase">Tax</th>
          <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Total</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @invoice.line_items.order(:position).each do |item| %>
          <tr>
            <td class="px-4 py-3 font-medium text-gray-900"><%= item.name %></td>
            <td class="px-4 py-3 text-gray-600"><%= item.description %></td>
            <td class="px-4 py-3 text-right"><%= item.quantity %></td>
            <td class="px-4 py-3 text-right"><%= number_to_currency(item.unit_price) %></td>
            <td class="px-4 py-3 text-center"><%= item.taxable? ? "✓" : "" %></td>
            <td class="px-4 py-3 text-right font-medium"><%= number_to_currency(item.total) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot class="bg-gray-50">
        <tr>
          <td colspan="5" class="px-4 py-2 text-right font-medium text-gray-700">Subtotal:</td>
          <td class="px-4 py-2 text-right font-medium"><%= number_to_currency(@invoice.subtotal) %></td>
        </tr>
        <% if @invoice.tax_rate.to_f > 0 %>
          <tr>
            <td colspan="5" class="px-4 py-2 text-right text-gray-600">Sales Tax (<%= number_to_percentage(@invoice.tax_rate * 100, precision: 2, strip_insignificant_zeros: true) %>):</td>
            <td class="px-4 py-2 text-right"><%= number_to_currency(@invoice.tax_total) %></td>
          </tr>
        <% end %>
        <% @invoice.adjustments.order(:position).each do |adj| %>
          <tr>
            <td colspan="5" class="px-4 py-2 text-right text-gray-600"><%= adj.label %>:</td>
            <td class="px-4 py-2 text-right <%= adj.adjustment_type == 'discount' ? 'text-green-700' : '' %>"><%= adj.adjustment_type == 'discount' ? "-#{number_to_currency(adj.amount)}" : number_to_currency(adj.amount) %></td>
          </tr>
        <% end %>
        <tr class="font-bold">
          <td colspan="5" class="px-4 py-3 text-right text-gray-900">Total:</td>
          <td class="px-4 py-3 text-right text-gray-900"><%= number_to_currency(@invoice.total) %></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <!-- Payments -->
  <% if @invoice.payments.any? %>
    <div class="mt-6 pt-6 border-t border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900 mb-3">Payments</h2>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Method</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Reference</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Notes</th>
              <th class="px-4 py-2 text-right text-xs font-medium text-gray-500 uppercase">Amount</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @invoice.payments.order(paid_at: :asc).each do |payment| %>
              <tr>
                <td class="px-4 py-3 text-gray-900"><%= payment.paid_at.strftime("%b %-d, %Y") %></td>
                <td class="px-4 py-3">
                  <% if payment.deposit? %>
                    <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Deposit</span>
                  <% else %>
                    <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700">Payment</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-gray-600"><%= payment.payment_method&.titleize || "—" %></td>
                <td class="px-4 py-3 text-gray-600"><%= payment.reference_number || "—" %></td>
                <td class="px-4 py-3 text-gray-600"><%= payment.notes || "—" %></td>
                <td class="px-4 py-3 text-right font-medium text-green-700"><%= number_to_currency(payment.amount) %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="bg-gray-50">
            <tr class="font-bold">
              <td colspan="5" class="px-4 py-2 text-right text-gray-900">Total Paid:</td>
              <td class="px-4 py-2 text-right text-green-700"><%= number_to_currency(@invoice.amount_paid) %></td>
            </tr>
            <tr class="font-bold">
              <td colspan="5" class="px-4 py-2 text-right text-gray-900">Balance Due:</td>
              <td class="px-4 py-2 text-right <%= @invoice.balance_due <= 0 ? 'text-green-700' : 'text-gray-900' %>"><%= number_to_currency(@invoice.balance_due) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  <% end %>

  <% if @invoice.payments.empty? %>
    <div class="mt-4 text-sm text-right text-gray-600">
      <p class="font-bold text-gray-900">Balance Due: <%= number_to_currency(@invoice.balance_due) %></p>
    </div>
  <% end %>

  <% if @invoice.notes.present? %>
    <div class="mt-4 pt-4 border-t border-gray-100">
      <p class="text-gray-500 text-sm mb-1">Notes</p>
      <p class="text-gray-700 text-sm whitespace-pre-line"><%= @invoice.notes %></p>
    </div>
  <% end %>
</div>

<!-- Attachments -->
<%= render "admin/attachments/section", attachable: @invoice, attachments: @invoice.attachments.includes(:uploaded_by, file_attachment: :blob).recent %>

<!-- Record Payment Modal Template -->
<template id="record-payment-template">
  <div data-controller="payment-form"
       data-payment-form-balance-due-value="<%= @invoice.balance_due %>"
       data-payment-form-deposit-amount-value="<%= @invoice.deposit_amount || 0 %>"
       data-payment-form-has-deposit-value="<%= @invoice.deposit_paid? %>">
    <h3 class="text-lg font-bold text-gray-900 mb-4">Record Payment</h3>
    <% payment_url = @invoice.project ? record_payment_admin_project_invoice_path(@invoice.project, @invoice) : record_payment_admin_invoice_path(@invoice) %>
    <%= form_with url: payment_url, method: :patch, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <div class="flex items-center justify-between mb-1">
            <%= f.label :amount, class: "text-sm font-semibold text-gray-700" %>
            <button type="button" data-action="payment-form#fillBalance" class="text-xs text-accent hover:text-accent-hover font-medium cursor-pointer">Pay Balance (<%= number_to_currency(@invoice.balance_due) %>)</button>
          </div>
          <%= f.number_field :amount, step: 0.01, min: 0, class: "input-admin w-full", required: true, name: "payment[amount]", data: { "payment-form-target": "amount" } %>
        </div>
        <div>
          <%= f.label :paid_at, "Date Paid", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <%= f.text_field :paid_at, value: Date.current.iso8601, class: "input-admin w-full", required: true, name: "payment[paid_at]", data: { controller: "flatpickr" } %>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Payment Method</label>
          <select name="payment[payment_method]" class="input-admin w-full">
            <option value="">— Select —</option>
            <option value="cash">Cash</option>
            <option value="check">Check</option>
            <option value="credit_card">Credit Card</option>
            <option value="bank_transfer">Bank Transfer</option>
            <option value="venmo">Venmo</option>
            <option value="zelle">Zelle</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div>
          <label for="payment_reference_number" class="block text-sm font-semibold text-gray-700 mb-1">Reference #</label>
          <input type="text" name="payment[reference_number]" id="payment_reference_number" class="input-admin w-full" placeholder="Check #, confirmation code, etc.">
        </div>
      </div>

      <div>
        <label for="payment_notes" class="block text-sm font-semibold text-gray-700 mb-1">Notes</label>
        <textarea name="payment[notes]" id="payment_notes" rows="2" class="input-admin w-full resize-none" placeholder="Optional payment notes"></textarea>
      </div>

      <div class="flex items-center gap-2">
        <input type="hidden" name="payment[deposit]" value="0">
        <input type="checkbox" name="payment[deposit]" value="1" id="payment_deposit" class="rounded border-gray-300 text-accent focus:ring-accent" data-payment-form-target="deposit" data-action="change->payment-form#toggleDeposit">
        <label for="payment_deposit" class="text-sm font-medium text-gray-700">This is a deposit payment</label>
      </div>

      <div class="flex justify-end gap-3 mt-6">
        <button type="button" data-role="modal-cancel" class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition cursor-pointer">Cancel</button>
        <button type="submit" class="btn-admin cursor-pointer">Record Payment</button>
      </div>
    <% end %>
  </div>
</template>
