<div class="nested-form-item flex gap-3 items-end mb-3 p-3 border border-gray-200 rounded-lg" data-nested-form-target="item">
  <div class="flex-1">
    <%= f.label :name, "Name", class: "block text-xs font-medium text-gray-600 mb-1" %>
    <%= f.text_field :name, class: "input-admin w-full text-sm", required: true, placeholder: "e.g. Materials & Supplies" %>
  </div>
  <div class="flex-1">
    <%= f.label :description, class: "block text-xs font-medium text-gray-600 mb-1" %>
    <%= f.text_field :description, class: "input-admin w-full text-sm", placeholder: "Optional details" %>
  </div>
  <div class="w-20">
    <%= f.label :quantity, "Qty", class: "block text-xs font-medium text-gray-600 mb-1" %>
    <%= f.number_field :quantity, class: "input-admin w-full text-sm", min: 1, value: f.object.quantity || 1 %>
  </div>
  <div class="w-32">
    <%= f.label :unit_price, "Unit Price", class: "block text-xs font-medium text-gray-600 mb-1" %>
    <%= f.number_field :unit_price, step: 0.01, min: 0, class: "input-admin w-full text-sm", required: true %>
  </div>
  <div>
    <button type="button" data-action="nested-form#remove" class="text-red-400 hover:text-red-600 text-sm cursor-pointer mb-2">Remove</button>
    <%= f.hidden_field :_destroy, value: "0", data: { "nested-form-target": "destroy" } %>
  </div>
</div>
