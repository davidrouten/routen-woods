<%= form_with(model: [:admin, attachable, attachment], class: "space-y-6") do |f| %>
  <% if attachment.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-xl p-4">
      <ul class="list-disc list-inside text-red-700 text-sm">
        <% attachment.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-sm p-6 space-y-5">
    <div class="flex items-center gap-4 mb-2">
      <% if attachment.image? %>
        <%= image_tag rails_blob_path(attachment.file, disposition: "inline"), class: "w-16 h-16 object-cover rounded-lg border border-gray-200", alt: attachment.filename %>
      <% else %>
        <div class="w-16 h-16 bg-gray-200 rounded-lg flex items-center justify-center text-gray-500">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
      <% end %>
      <div>
        <p class="font-medium text-gray-900"><%= attachment.filename %></p>
        <p class="text-sm text-gray-500"><%= number_to_human_size(attachment.file_size) %> &middot; <%= attachment.file.content_type %></p>
      </div>
    </div>

    <div>
      <label class="block text-sm font-semibold text-gray-700 mb-1.5">Belongs To</label>
      <% current_value = "#{attachment.attachable_type}-#{attachment.attachable_id}" %>
      <select name="attachment[attachable_gid]" class="input-admin w-full">
        <optgroup label="Projects">
          <% Project.order(:title).each do |p| %>
            <option value="Project-<%= p.id %>" <%= "selected" if current_value == "Project-#{p.id}" %>><%= p.title %></option>
          <% end %>
        </optgroup>
        <optgroup label="Invoices">
          <% Invoice.order(:invoice_number).each do |inv| %>
            <option value="Invoice-<%= inv.id %>" <%= "selected" if current_value == "Invoice-#{inv.id}" %>><%= inv.invoice_number %><%= " — #{inv.project.title}" if inv.project %></option>
          <% end %>
        </optgroup>
        <optgroup label="Order Forms">
          <% OrderForm.order(:supplier_name).each do |of| %>
            <option value="OrderForm-<%= of.id %>" <%= "selected" if current_value == "OrderForm-#{of.id}" %>><%= of.supplier_name %><%= " — #{of.project.title}" if of.project %></option>
          <% end %>
        </optgroup>
      </select>
    </div>

    <div>
      <%= f.label :description, class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
      <%= f.text_area :description, rows: 3, class: "input-admin w-full resize-none", placeholder: "Add notes about this file..." %>
    </div>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to "Cancel", polymorphic_path([:admin, attachable, attachment]), class: "btn-admin-secondary" %>
    <%= f.submit "Update Attachment", class: "btn-admin" %>
  </div>
<% end %>
