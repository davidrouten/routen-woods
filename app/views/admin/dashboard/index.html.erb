<h1 class="text-2xl font-bold text-gray-900 mb-6"><%= t("admin.dashboard.title") %></h1>

<!-- Stats Grid -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
  <div class="bg-white rounded-xl shadow-sm p-6">
    <p class="text-sm text-gray-500 mb-1"><%= t("admin.dashboard.leads_today") %></p>
    <p class="text-3xl font-bold text-primary"><%= @leads_today %></p>
  </div>
  <div class="bg-white rounded-xl shadow-sm p-6">
    <p class="text-sm text-gray-500 mb-1"><%= t("admin.dashboard.total_leads") %></p>
    <p class="text-3xl font-bold text-primary"><%= @leads_by_status.values.sum %></p>
  </div>
  <div class="bg-white rounded-xl shadow-sm p-6">
    <p class="text-sm text-gray-500 mb-1"><%= t("admin.dashboard.hot_leads") %></p>
    <p class="text-3xl font-bold text-red-600"><%= @hot_leads.size %></p>
  </div>
  <div class="bg-white rounded-xl shadow-sm p-6">
    <p class="text-sm text-gray-500 mb-1"><%= t("admin.dashboard.spam_count") %></p>
    <p class="text-3xl font-bold text-gray-400"><%= @spam_count %></p>
  </div>
</div>

<!-- Schedule Widget -->
<div id="dash-schedule" class="bg-white rounded-xl shadow-sm p-6 mb-8">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold text-gray-900">This Week</h2>
    <%= link_to "Full Schedule", admin_schedule_path, class: "text-sm text-accent hover:text-accent-hover" %>
  </div>

  <!-- This Week strip -->
  <div class="grid grid-cols-7 gap-2 mb-6">
    <% @week_schedule.each do |day| %>
      <div class="text-center">
        <div class="text-xs font-medium <%= day[:sunday] ? 'text-gray-400' : 'text-gray-500' %> mb-1"><%= day[:date].strftime("%a") %></div>
        <div class="h-10 rounded-lg flex items-center justify-center text-xs font-medium
          <%= if day[:sunday]
                'bg-gray-100 text-gray-400 border border-gray-200'
              elsif day[:busy]
                'bg-accent/15 text-accent border border-accent/30'
              else
                'bg-gray-50 text-gray-400 border border-gray-200'
              end %>
          <%= day[:date] == Date.current ? 'ring-2 ring-accent/40' : '' %>">
          <%= day[:date].strftime("%-d") %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- 8-week density grid -->
  <div id="schedule-outlook">
    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">8-Week Outlook</h3>
    <div class="space-y-1">
      <% @density_grid.each do |week| %>
        <div class="flex items-center gap-1">
          <span class="text-[10px] text-gray-400 w-12 shrink-0 text-right pr-1"><%= week.first[:date].strftime("%b %-d") %></span>
          <div class="flex gap-0.5 flex-1">
            <% week.each do |day| %>
              <%
                month_shade = day[:month] % 2 == 0 ? "bg-white" : "bg-gray-100"
                sunday_shade = day[:month] % 2 == 0 ? "bg-gray-50" : "bg-gray-200/60"
                has_projects = day[:project_ids].any?
                if day[:sunday]
                  cell_class = sunday_shade
                  cell_style = nil
                elsif has_projects
                  color = @project_colors[day[:project_ids].first]
                  alpha = case day[:count]
                          when 1 then "90"
                          when 2 then "B0"
                          else "D0"
                          end
                  cell_class = nil
                  cell_style = "background-color: #{color}#{alpha};"
                else
                  cell_class = month_shade
                  cell_style = nil
                end
              %>
              <%
                stripe_class = if day[:count] >= 3
                  "sched-triple"
                elsif day[:count] == 2
                  "sched-double"
                end
              %>
              <div class="flex-1 h-4 rounded-sm <%= cell_class %> <%= stripe_class %> <%= "proj sched-cell cursor-pointer #{day[:project_ids].map { |id| "proj-#{id}" }.join(' ')}" if has_projects %>"
                   <% if cell_style %>style="<%= cell_style %>"<% end %>
                   title="<%= day[:date].strftime('%a, %b %-d') %>: <%= day[:count] %> project<%= day[:count] != 1 ? 's' : '' %>"
                   <% if has_projects %>data-projects="<%= day[:project_ids].join(',') %>"<% end %>></div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Project key -->
  <% if @schedule_key.any? %>
    <div class="flex flex-wrap gap-x-4 gap-y-1.5 mt-4">
      <% @schedule_key.each do |entry| %>
        <%= link_to entry[:url], class: "proj proj-key proj-#{entry[:id]} inline-flex items-center gap-1.5 px-1.5 py-0.5 rounded text-xs text-gray-700 hover:text-gray-900",
            style: "--proj-color: #{entry[:color]}",
            data: { projects: entry[:id].to_s } do %>
          <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background-color: <%= entry[:color] %>"></span>
          <span class="truncate"><%= entry[:label] %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

<style>
  #dash-schedule .proj { transition: opacity 0.2s ease, filter 0.2s ease, background-color 0.2s ease; }
  #dash-schedule.highlighting .proj.dimmed { opacity: 0.15; }
  #dash-schedule.highlighting .sched-cell.highlighted { filter: brightness(1.35) saturate(1.3); outline: 2px solid rgba(0,0,0,0.15); outline-offset: -1px; }
  #dash-schedule.highlighting .proj-key.highlighted { background-color: color-mix(in srgb, var(--proj-color) 20%, transparent); font-weight: 600; }
  .sched-double {
    background-image: repeating-linear-gradient(
      135deg, transparent, transparent 2px,
      rgba(255,255,255,0.45) 2px, rgba(255,255,255,0.45) 4px
    );
  }
  .sched-triple {
    background-image:
      repeating-linear-gradient(
        135deg, transparent, transparent 2px,
        rgba(255,255,255,0.4) 2px, rgba(255,255,255,0.4) 4px
      ),
      repeating-linear-gradient(
        45deg, transparent, transparent 2px,
        rgba(255,255,255,0.4) 2px, rgba(255,255,255,0.4) 4px
      );
  }
</style>

<script>
  (function() {
    var container = document.getElementById("dash-schedule");
    if (!container) return;

    var urlMap = {};
    var colorMap = {};
    container.querySelectorAll("a[data-projects]").forEach(function(a) {
      urlMap[a.dataset.projects] = a.getAttribute("href");
    });
    container.querySelectorAll(".proj-key").forEach(function(el) {
      var dot = el.querySelector("[style*='background-color']");
      if (!dot) return;
      var color = dot.style.backgroundColor;
      var m = el.className.match(/proj-(\d+)/);
      if (m) colorMap[m[1]] = color;
    });

    container.addEventListener("click", function(e) {
      var cell = e.target.closest(".sched-cell");
      if (!cell) return;
      var id = cell.dataset.projects.split(",")[0];
      if (urlMap[id]) window.location.href = urlMap[id];
    });

    function highlight(ids) {
      container.classList.add("highlighting");
      var projColor = colorMap[ids[0]] || null;
      container.querySelectorAll(".proj").forEach(function(el) {
        var match = ids.some(function(id) { return el.classList.contains("proj-" + id); });
        el.classList.toggle("highlighted", match);
        el.classList.toggle("dimmed", !match);
        if (match && projColor && el.classList.contains("sched-cell") && ids.length === 1) {
          if (!el.dataset.origBg) el.dataset.origBg = el.style.backgroundColor;
          el.style.backgroundColor = projColor;
        }
      });
    }

    function clearHighlight() {
      container.classList.remove("highlighting");
      container.querySelectorAll(".proj").forEach(function(el) {
        el.classList.remove("highlighted", "dimmed");
        if (el.dataset.origBg) {
          el.style.backgroundColor = el.dataset.origBg;
          delete el.dataset.origBg;
        }
      });
    }

    container.addEventListener("mouseenter", function(e) {
      var el = e.target.closest(".proj");
      if (!el) return;
      var data = el.dataset.projects;
      var ids = data ? data.split(",") : [];
      if (ids.length === 0) {
        var match = el.className.match(/proj-(\d+)/g);
        if (match) ids = match.map(function(c) { return c.replace("proj-", ""); });
      }
      if (ids.length > 0) highlight(ids);
    }, true);

    container.addEventListener("mouseleave", function(e) {
      if (e.target.closest(".proj")) clearHighlight();
    }, true);
  })();
</script>

<!-- Status Breakdown (hidden) -->
<div class="hidden bg-white rounded-xl shadow-sm p-6 mb-8">
  <h2 class="text-lg font-semibold text-gray-900 mb-4">Leads by Status</h2>
  <div class="flex flex-wrap gap-3">
    <% Lead.statuses.each_key do |status| %>
      <%= link_to admin_leads_path(status: status), class: "inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium #{status_badge_color(status)}" do %>
        <%= t("admin.leads.status.#{status}") %>
        <span class="bg-white/50 px-2 py-0.5 rounded-full text-xs"><%= @leads_by_status[status] || 0 %></span>
      <% end %>
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
  <!-- Recent Leads -->
  <div class="bg-white rounded-xl shadow-sm p-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-lg font-semibold text-gray-900"><%= t("admin.dashboard.recent_leads") %></h2>
      <%= link_to "View all", admin_leads_path, class: "text-sm text-accent hover:text-accent-hover" %>
    </div>
    <div class="space-y-3">
      <% @recent_leads.each do |lead| %>
        <%= link_to admin_lead_path(lead), class: "block p-3 rounded-lg transition #{lead.status == 'booked' ? 'bg-orange-50 hover:bg-orange-100' : 'hover:bg-gray-50'}" do %>
          <div class="flex justify-between items-start">
            <div>
              <p class="font-medium text-gray-900"><%= lead.first_name %> <%= lead.last_name %></p>
              <p class="text-sm text-gray-500"><%= lead.service_names %></p>
            </div>
            <div class="text-right">
              <span class="inline-block px-2 py-1 rounded-full text-xs font-medium <%= status_badge_color(lead.status) %>"><%= lead.status.titleize %></span>
              <p class="text-xs text-gray-400 mt-1"><%= time_ago_in_words(lead.created_at) %> ago</p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Job Board -->
  <div class="bg-white rounded-xl shadow-sm p-6">
    <div class="flex justify-between items-center mb-3">
      <h2 class="text-lg font-semibold text-gray-900">Job Board</h2>
      <%= link_to "View all", admin_leads_path(status: :booked), class: "text-sm text-accent hover:text-accent-hover" %>
    </div>

    <div class="grid grid-cols-3 gap-3 mb-4 p-3 bg-gray-50 rounded-lg">
      <div>
        <p class="text-xs text-gray-500">Booked Revenue</p>
        <p class="text-lg font-bold text-orange-700"><%= number_to_currency(@booked_revenue, precision: 0) %></p>
      </div>
      <div>
        <p class="text-xs text-gray-500">Outstanding</p>
        <p class="text-lg font-bold text-red-600"><%= number_to_currency(@total_outstanding, precision: 0) %></p>
      </div>
      <div>
        <p class="text-xs text-gray-500">Collected (<%= Date.current.strftime("%b") %>)</p>
        <p class="text-lg font-bold text-emerald-700"><%= number_to_currency(@collected_this_month, precision: 0) %></p>
      </div>
    </div>

    <div class="space-y-2">
      <% @booked_leads.each do |lead| %>
        <% project = lead.projects.first %>
        <% invoice = project&.invoices&.first %>
        <%= link_to admin_lead_path(lead), class: "block p-3 rounded-lg bg-orange-50 hover:bg-orange-100 transition" do %>
          <div class="flex justify-between items-start">
            <div class="min-w-0 flex-1">
              <p class="font-medium text-gray-900 truncate"><%= lead.first_name %> <%= lead.last_name %></p>
              <p class="text-xs text-gray-500 truncate"><%= lead.service_names %></p>
            </div>
            <div class="text-right ml-3 shrink-0">
              <% if invoice&.total&.positive? %>
                <p class="text-sm"><span class="font-semibold <%= invoice.amount_paid >= invoice.total ? 'text-emerald-700' : 'text-gray-900' %>"><%= number_to_currency(invoice.amount_paid) %></span><span class="text-gray-400"> / <%= number_to_currency(invoice.total) %></span></p>
              <% elsif project&.agreed_price %>
                <p class="font-semibold text-gray-900 text-sm"><%= number_to_currency(project.agreed_price) %></p>
              <% end %>
              <% if invoice&.due_date %>
                <p class="text-xs <%= invoice.due_date < Date.current ? 'text-red-600 font-medium' : 'text-gray-400' %>">Due <%= invoice.due_date.strftime("%-m/%-d") %></p>
              <% elsif project&.scheduled_start_date %>
                <p class="text-xs text-gray-400">Starts <%= project.scheduled_start_date.strftime("%-m/%-d") %></p>
              <% end %>
            </div>
          </div>
          <% deposit = project&.deposit_amount.to_d > 0 ? project.deposit_amount : invoice&.deposit_amount.to_d > 0 ? invoice.deposit_amount : nil %>
          <% if deposit || invoice&.due_date %>
            <div class="flex gap-3 mt-1.5 text-xs text-gray-500">
              <% if deposit %>
                <span>Dep: <%= number_to_currency(deposit) %><% if invoice&.deposit_paid? %> <span class="text-emerald-600">paid</span><% end %></span>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>

      <% if @completed_leads.any? %>
        <div class="border-t border-gray-100 pt-2 mt-2">
          <p class="text-xs font-semibold text-emerald-700 uppercase tracking-wide mb-2">Completed</p>
          <% @completed_leads.each do |lead| %>
            <% project = lead.projects.first %>
            <%= link_to admin_lead_path(lead), class: "block p-2 rounded-lg hover:bg-emerald-50 transition" do %>
              <div class="flex justify-between items-center">
                <p class="text-sm text-gray-700 truncate"><%= lead.first_name %> <%= lead.last_name %></p>
                <div class="text-right ml-3 shrink-0">
                  <% if project&.agreed_price %>
                    <span class="text-sm font-medium text-emerald-700"><%= number_to_currency(project.agreed_price) %></span>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <% if @booked_leads.empty? && @completed_leads.empty? %>
        <p class="text-gray-400 text-sm text-center py-4">No booked or completed jobs yet</p>
      <% end %>
    </div>
  </div>
</div>
