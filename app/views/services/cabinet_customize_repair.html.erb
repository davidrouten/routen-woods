<% service = t("business.services.cabinet_customize_repair") %>
<% content_for(:title) { "#{service[:name]} | #{t('business.name')}" } %>
<% content_for(:meta_description) { service[:hero_subheading] } %>

<%= render "shared/service_hero", service: service %>
<%= render "shared/service_detail", service: service %>
<%= render "shared/gallery_grid", images: @gallery_images if @gallery_images.any? %>
<%= render "shared/cta_inline" %>
<%= render "shared/contact_section", lead: @lead, form_page: "cabinet_customize_repair" %>
