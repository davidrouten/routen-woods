<div class="min-h-[70vh] flex items-center justify-center py-12 px-4">
  <div class="bg-white rounded-xl shadow-lg p-8 w-full max-w-md">
    <div class="text-center mb-8">
      <h2 class="text-2xl font-bold text-[#0f1b2d]">Log In</h2>
      <p class="text-gray-500 mt-1">Sign in to your account</p>
    </div>

    <%= form_with(url: session_path(resource_name), scope: resource_name, class: "space-y-6") do |f| %>
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#d4a338] focus:border-transparent outline-none transition", required: true %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#d4a338] focus:border-transparent outline-none transition", required: true %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center">
          <%= f.check_box :remember_me, class: "rounded text-[#d4a338] focus:ring-[#d4a338] mr-2" %>
          <%= f.label :remember_me, class: "text-sm text-gray-600" %>
        </div>
      <% end %>

      <div>
        <%= f.submit "Log In", class: "w-full px-8 py-3 bg-[#d4a338] text-[#0f1b2d] font-bold rounded-lg text-lg hover:bg-[#b8860b] transition shadow-lg cursor-pointer" %>
      </div>
    <% end %>

    <div class="mt-6 text-center text-sm text-gray-500">
      <%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-[#d4a338] hover:text-[#b8860b]" %>
    </div>
  </div>
</div>
