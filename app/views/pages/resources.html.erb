<% content_for(:title) { "Resources | #{t('business.name')}" } %>

<section class="relative bg-brand-gradient py-16 overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-10 left-20 w-72 h-72 bg-accent glow-orb rounded-full blur-3xl"></div>
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="section-label">Resources</p>
    <h1 class="text-5xl md:text-6xl font-extrabold text-white mb-4">Helpful Resources</h1>
  </div>
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 60" fill="none" preserveAspectRatio="none" class="w-full h-12 md:h-16">
      <path d="M0 60L1440 60L1440 30C1200 0 240 0 0 30L0 60Z" fill="white"/>
    </svg>
  </div>
</section>

<section class="py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-xl text-gray-600 leading-relaxed mb-12 text-center">
      Find important documents, policies, and guides to help you through your project with <%= t("business.name") %>.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
      <!-- Workmanship Warranty Card -->
      <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-8 hover:shadow-xl transition-shadow duration-300">
        <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center mb-5">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-primary mb-3">Workmanship Warranty</h3>
        <p class="text-gray-500 leading-relaxed">Learn about our commitment to quality craftsmanship and our warranty coverage.</p>
        <p class="text-sm text-gray-400 mt-4 italic">Coming soon</p>
      </div>
    </div>
  </div>
</section>
