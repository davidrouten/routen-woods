<% content_for(:title) { "Resources | #{t('business.name')}" } %>
<% content_for(:meta_description) { t("business.seo.pages.resources.description") } %>

<section class="relative bg-brand-gradient py-16 overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-10 left-20 w-72 h-72 bg-accent glow-orb rounded-full blur-3xl"></div>
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="section-label">Resources</p>
    <h1 class="text-5xl md:text-6xl font-extrabold text-white mb-4">Helpful Resources</h1>
  </div>
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 60" fill="none" preserveAspectRatio="none" class="w-full h-12 md:h-16">
      <path d="M0 60L1440 60L1440 30C1200 0 240 0 0 30L0 60Z" fill="white"/>
    </svg>
  </div>
</section>

<section class="py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-xl text-gray-600 leading-relaxed mb-12 text-center">
      Find important documents, policies, and guides to help you through your project with <%= t("business.name") %>.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
      <!-- Workmanship Warranty Card -->
      <button data-action="modal#openContent" data-modal-target="#warranty-content" data-modal-size="lg"
              class="bg-white rounded-2xl shadow-lg border border-gray-100 p-8 hover:shadow-xl transition-shadow duration-300 text-left cursor-pointer group">
        <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center mb-5">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-primary mb-3 group-hover:text-accent transition-colors">Workmanship Warranty</h3>
        <p class="text-gray-500 leading-relaxed">Learn about our commitment to quality craftsmanship and our warranty coverage.</p>
      </button>
    </div>

    <template id="warranty-content">
      <div>
        <div class="flex justify-between items-start mb-6">
          <div>
            <h3 class="text-xl font-bold text-primary">1 Year - Limited Workmanship Warranty Policy</h3>
            <p class="text-sm text-gray-400 mt-1">Routen Woods LLC &mdash; Rev 1 - 8/11/26</p>
          </div>
          <button data-role="modal-cancel" class="text-gray-400 hover:text-gray-600 transition cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <p class="text-gray-700 mb-5">We are pleased to provide our customers with the following warranty coverage:</p>

        <div class="space-y-5 text-sm text-gray-700 leading-relaxed">
          <div>
            <h4 class="font-semibold text-gray-900 mb-1">Warranty Coverage</h4>
            <p>All products are warranted to be free from defects in materials and workmanship for a period of one (1) year from the date of installation. During this period, if a product is found to be defective under normal use and maintenance, we will, at our discretion, repair or replace the product at no additional cost.</p>
          </div>

          <div>
            <h4 class="font-semibold text-gray-900 mb-1">Exclusions</h4>
            <p>This warranty does not cover damages resulting from misuse, neglect, unauthorized repair or modification, any exposure to moisture or water, or external factors such as accidents, natural disasters, or improper temperatures or humidity levels.</p>
          </div>

          <div>
            <h4 class="font-semibold text-gray-900 mb-1">Claim Process</h4>
            <p>To make a warranty claim, please contact our admin team with original, signed Quote Document and install date. Claims must be submitted within the warranty period to be considered valid.</p>
          </div>

          <div>
            <h4 class="font-semibold text-gray-900 mb-1">Disclaimer</h4>
            <p>This warranty is the sole and exclusive warranty provided and replaces all other warranties, express or implied, including any warranty of merchantability or fitness for a particular purpose.</p>
            <p class="mt-2">This warranty ensures that your purchase is protected for one year beyond the installation date, giving you confidence in the reliability and quality of our products.</p>
          </div>

          <div class="pt-3 border-t border-gray-100">
            <p class="text-gray-600">Additionally: Our Laminate, 3DL/Vinyl Wrap Doors &amp; Drawer Fronts and accompanying products are also covered under a 5 year manufacturer's warranty. Information available upon request.</p>
          </div>
        </div>
      </div>
    </template>
  </div>
</section>
