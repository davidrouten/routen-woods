<% content_for(:title) { "Contact | #{t('business.name')}" } %>

<section class="relative bg-brand-gradient py-16 overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute bottom-10 right-20 w-72 h-72 bg-accent glow-orb rounded-full blur-3xl"></div>
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="section-label">Get In Touch</p>
    <h1 class="text-5xl md:text-6xl font-extrabold text-white mb-4"><%= t("business.sections.contact.heading") %></h1>
    <p class="text-gray-300 text-lg"><%= t("business.sections.contact.subheading") %></p>
  </div>
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 60" fill="none" preserveAspectRatio="none" class="w-full h-12 md:h-16">
      <path d="M0 60L1440 60L1440 30C1200 0 240 0 0 30L0 60Z" fill="white"/>
    </svg>
  </div>
</section>

<%= render "shared/contact_section", lead: @lead, show_header: false %>
