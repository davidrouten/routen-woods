<% content_for(:title) { "Contact | #{t('business.name')}" } %>

<section class="bg-gradient-to-br from-[#0f1b2d] to-[#1b2a4a] py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-4xl font-bold text-white mb-4"><%= t("business.sections.contact.heading") %></h1>
    <p class="text-gray-300 text-lg"><%= t("business.sections.contact.subheading") %></p>
  </div>
</section>

<section class="py-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <!-- Contact Form -->
      <div>
        <h2 class="text-2xl font-bold text-[#0f1b2d] mb-6"><%= t("business.forms.contact.heading") %></h2>
        <%= render "shared/quote_form", lead: @lead %>
      </div>

      <!-- Contact Info -->
      <div class="space-y-8">
        <div>
          <h3 class="text-lg font-bold text-[#0f1b2d] mb-2">Address</h3>
          <p class="text-gray-600"><%= t("business.address.full") %></p>
        </div>
        <div>
          <h3 class="text-lg font-bold text-[#0f1b2d] mb-2">Phone</h3>
          <p><%= link_to t("business.phone"), "tel:#{t("business.phone_raw")}", class: "text-[#d4a338] hover:text-[#b8860b] transition" %></p>
        </div>
        <div>
          <h3 class="text-lg font-bold text-[#0f1b2d] mb-2">Email</h3>
          <p><%= mail_to t("business.email"), t("business.email"), class: "text-[#d4a338] hover:text-[#b8860b] transition" %></p>
        </div>
        <div>
          <h3 class="text-lg font-bold text-[#0f1b2d] mb-2">Hours</h3>
          <p class="text-gray-600"><%= t("business.hours") %></p>
        </div>
        <div>
          <h3 class="text-lg font-bold text-[#0f1b2d] mb-2">Service Area</h3>
          <p class="text-gray-600"><%= t("business.service_area") %></p>
        </div>
      </div>
    </div>
  </div>
</section>
