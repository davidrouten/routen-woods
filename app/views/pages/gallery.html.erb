<% content_for(:title) { "Gallery | #{t('business.name')}" } %>

<section class="relative bg-brand-gradient py-16 overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-10 left-1/2 w-72 h-72 bg-accent glow-orb rounded-full blur-3xl"></div>
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="section-label">Portfolio</p>
    <h1 class="text-5xl md:text-6xl font-extrabold text-white mb-4"><%= t("business.sections.gallery.heading") %></h1>
    <p class="text-gray-300 text-lg"><%= t("business.sections.gallery.subheading") %></p>
  </div>
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 60" fill="none" preserveAspectRatio="none" class="w-full h-12 md:h-16">
      <path d="M0 60L1440 60L1440 30C1200 0 240 0 0 30L0 60Z" fill="white"/>
    </svg>
  </div>
</section>

<section class="py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <% if @images.any? %>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" data-controller="lightbox">
        <% @images.each do |image| %>
          <div class="group relative overflow-hidden rounded-2xl aspect-square bg-gray-200 shadow-sm hover:shadow-xl transition-all duration-500 cursor-pointer"
               data-lightbox-target="item"
               data-action="click->lightbox#open"
               data-lightbox-url="<%= image.image.attached? ? url_for(image.image.variant(resize_to_limit: [1600, 1600], format: :webp)) : '' %>">
            <% if image.image.attached? %>
              <%= responsive_gallery_image image.image, alt: image.title,
                  class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center text-gray-300">
                <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
            <% end %>
            <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-5">
              <div>
                <p class="text-white font-semibold"><%= image.title %></p>
                <% if image.description.present? %>
                  <p class="text-gray-300 text-sm mt-1"><%= image.description %></p>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-20">
        <div class="w-24 h-24 mx-auto mb-6 bg-gray-100 rounded-2xl flex items-center justify-center">
          <svg class="w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </div>
        <p class="text-gray-400 text-lg">Gallery coming soon! Check back for photos of our recent work.</p>
      </div>
    <% end %>
  </div>
</section>

<%= render "shared/cta_inline" %>
