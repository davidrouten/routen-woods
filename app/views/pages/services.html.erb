<% content_for(:title) { "Services | #{t('business.name')}" } %>

<section class="bg-gradient-to-br from-[#0f1b2d] to-[#1b2a4a] py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-4xl font-bold text-white mb-4">Our Services</h1>
    <p class="text-gray-300 text-lg">Professional cabinet services tailored to your needs</p>
  </div>
</section>

<section class="py-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    <% I18n.t("business.services").each_with_index do |(key, service), index| %>
      <div id="<%= key %>" class="flex flex-col md:flex-row gap-8 items-center <%= 'md:flex-row-reverse' if index.odd? %>">
        <div class="md:w-1/2">
          <div class="bg-gray-100 rounded-xl aspect-video flex items-center justify-center">
            <svg class="w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
        </div>
        <div class="md:w-1/2">
          <h2 class="text-2xl font-bold text-[#0f1b2d] mb-3"><%= service[:name] %></h2>
          <p class="text-gray-600 mb-4"><%= service[:description] %></p>
          <p class="text-[#d4a338] font-semibold mb-6"><%= service[:price_starting] %></p>
          <%= link_to "Get a Quote", contact_path, class: "inline-flex items-center px-6 py-3 bg-[#d4a338] text-[#0f1b2d] font-bold rounded-lg hover:bg-[#b8860b] transition" %>
        </div>
      </div>
    <% end %>
  </div>
</section>

<%= render "shared/cta_inline" %>
