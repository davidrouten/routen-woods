<% content_for(:title) { "About | #{t('business.name')}" } %>

<section class="relative bg-brand-gradient py-16 overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-10 left-20 w-72 h-72 bg-accent glow-orb rounded-full blur-3xl"></div>
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="section-label">About Us</p>
    <h1 class="text-5xl md:text-6xl font-extrabold text-white mb-4"><%= t("business.sections.about.heading") %></h1>
  </div>
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 60" fill="none" preserveAspectRatio="none" class="w-full h-12 md:h-16">
      <path d="M0 60L1440 60L1440 30C1200 0 240 0 0 30L0 60Z" fill="white"/>
    </svg>
  </div>
</section>

<section class="py-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-xl text-gray-600 leading-relaxed mb-6"><%= t("business.sections.about.body") %></p>
    <p class="text-lg text-gray-500 leading-relaxed">We're a locally owned family business proud to serve homeowners across Oxford, Michigan. Every project is treated like our own home — because your trust matters to us.</p>
  </div>
</section>

<%= render "shared/about_section" %>
<%= render "shared/process_steps" %>
<%= render "shared/cta_inline" %>
