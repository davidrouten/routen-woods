<% content_for(:title) { "About | #{t('business.name')}" } %>

<section class="bg-gradient-to-br from-[#0f1b2d] to-[#1b2a4a] py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-4xl font-bold text-white mb-4"><%= t("business.sections.about.heading") %></h1>
  </div>
</section>

<section class="py-16">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="text-lg text-gray-700 leading-relaxed mb-12"><%= t("business.sections.about.body") %></p>
  </div>
</section>

<%= render "shared/about_section" %>
<%= render "shared/cta_inline" %>
