<% content_for(:title) { "About | #{t('business.name')}" } %>

<section class="relative bg-brand-gradient py-16 overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-10 left-20 w-72 h-72 bg-accent glow-orb rounded-full blur-3xl"></div>
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="section-label">About Us</p>
    <h1 class="text-5xl md:text-6xl font-extrabold text-white mb-4">Routen Woods</h1>
    <p class="text-xl text-gray-300 tracking-wide">~ A Cabinet Company ~</p>
  </div>
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 60" fill="none" preserveAspectRatio="none" class="w-full h-12 md:h-16">
      <path d="M0 60L1440 60L1440 30C1200 0 240 0 0 30L0 60Z" fill="white"/>
    </svg>
  </div>
</section>

<section class="py-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Intro -->
    <p class="text-xl text-gray-700 leading-relaxed mb-8">
      We pride ourselves on reliability, honest and open communication, passion, and quality work. We are a small, family-owned company making a living doing what we love.
    </p>

    <!-- Our Background -->
    <div class="mb-10">
      <h2 class="text-2xl font-bold text-primary mb-4">Cabinet Makers at Heart</h2>
      <p class="text-gray-600 leading-relaxed mb-4">
        We have over a decade of experience designing, fabricating, and installing custom and standard cabinets, monumental millwork, countertops, closets... you name it.
      </p>
    </div>

    <!-- Why Refacing -->
    <div class="mb-10">
      <h2 class="text-2xl font-bold text-primary mb-4">Why We Love Refacing</h2>
      <p class="text-gray-600 leading-relaxed mb-4">
        We fell in love with refacing when we discovered it. New cabinets have become prohibitively expensive for many homeowners, and that can be a truly discouraging feeling. Refacing delivers a dramatic transformation at a fraction of the cost, giving you the look and feel of a brand-new space.
      </p>
      <div class="bg-accent/10 border-l-4 border-accent rounded-r-xl px-6 py-4">
        <p class="text-primary font-bold text-lg">And the best part? A typical reface is completed within a week or less.</p>
      </div>
    </div>

    <!-- Products -->
    <div class="mb-10">
      <h2 class="text-2xl font-bold text-primary mb-4">What We Work With</h2>
      <p class="text-gray-600 leading-relaxed mb-4">
        We work with a great supplier offering top-of-the-line 3DL (3-D Laminate/Vinyl Wrap on machined MDF cores) products. 84 colors are available, including solids, woodgrains, and linens across 22 door styles. We also offer finished wood or painted MDF doors in the color of your choice.
      </p>
    </div>

    <!-- Repairs -->
    <div class="mb-10">
      <h2 class="text-2xl font-bold text-primary mb-4">Repairs, Accessories &amp; Modifications</h2>
      <p class="text-gray-600 leading-relaxed">
        We also repair, accessorize, and modify cabinets. Our goal is to make your cabinets and current space work as efficiently, and look as beautifully, as possible for you.
      </p>
    </div>

    <!-- CTA -->
    <div class="text-center pt-6">
      <p class="text-lg text-gray-700 font-medium mb-6">We'd love an opportunity to quote your project!</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <%= link_to contact_path, class: "btn-primary group" do %>
          Get a Free Quote
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        <% end %>
        <%= link_to "tel:#{t('business.phone_raw')}", class: "inline-flex items-center justify-center gap-2 px-8 py-4 border-2 border-primary text-primary font-semibold rounded-xl text-lg hover:bg-primary hover:text-white transition-all duration-300" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Call <%= t("business.phone") %>
        <% end %>
      </div>
    </div>
  </div>
</section>
