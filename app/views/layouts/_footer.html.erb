<footer class="bg-[#0f1b2d] text-gray-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Business Info -->
      <div>
        <h3 class="text-white text-lg font-bold mb-4"><%= t("business.name") %></h3>
        <p class="mb-2"><%= t("business.address.full") %></p>
        <p class="mb-2"><%= t("business.phone") %></p>
        <p class="mb-2"><%= t("business.email") %></p>
        <p><%= t("business.hours") %></p>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-white text-lg font-bold mb-4">Services</h3>
        <ul class="space-y-2">
          <% I18n.t("business.services").each do |key, service| %>
            <li><%= link_to service[:name], services_path(anchor: key), class: "hover:text-white transition" %></li>
          <% end %>
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-white text-lg font-bold mb-4">Quick Links</h3>
        <ul class="space-y-2">
          <li><%= link_to "Home", root_path, class: "hover:text-white transition" %></li>
          <li><%= link_to "Gallery", gallery_path, class: "hover:text-white transition" %></li>
          <li><%= link_to "About Us", about_path, class: "hover:text-white transition" %></li>
          <li><%= link_to "Contact", contact_path, class: "hover:text-white transition" %></li>
          <li><%= link_to "Get a Quote", contact_path, class: "text-[#d4a338] hover:text-[#b8860b] transition" %></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-700 mt-8 pt-8 text-center text-sm">
      <p><%= t("business.footer.copyright", year: Date.current.year, business_name: t("business.name")) %></p>
      <p class="mt-1"><%= t("business.footer.tagline", service_area: t("business.service_area")) %></p>
    </div>
  </div>
</footer>
