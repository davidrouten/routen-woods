<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    @page {
      size: letter;
      margin: 0.6in 0.75in;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 10pt;
      color: #1a1a1a;
      line-height: 1.5;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .pdf-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 3px solid #10264c;
      padding-bottom: 16px;
      margin-bottom: 24px;
    }
    .pdf-header .company-name {
      font-size: 22pt;
      font-weight: 700;
      color: #10264c;
      letter-spacing: -0.5px;
    }
    .pdf-header .company-details {
      text-align: right;
      font-size: 9pt;
      color: #555;
      line-height: 1.6;
    }
    .pdf-footer {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      text-align: center;
      font-size: 8pt;
      color: #999;
      border-top: 1px solid #ddd;
      padding-top: 8px;
    }
    table { width: 100%; border-collapse: collapse; }
    th {
      background-color: #10264c;
      color: #fff;
      font-size: 8pt;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 8px 12px;
      text-align: left;
    }
    th.text-right { text-align: right; }
    td { padding: 8px 12px; border-bottom: 1px solid #e5e5e5; font-size: 10pt; }
    td.text-right { text-align: right; }
    tr:nth-child(even) { background-color: #f9f9f9; }
    .totals-row td { border-bottom: none; }
    .totals-row.grand-total td {
      border-top: 2px solid #10264c;
      font-weight: 700;
      font-size: 11pt;
      padding-top: 10px;
    }
    .meta-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 24px;
    }
    .meta-block { font-size: 9pt; }
    .meta-block .label { color: #888; text-transform: uppercase; font-size: 7.5pt; font-weight: 600; letter-spacing: 0.5px; margin-bottom: 2px; }
    .meta-block .value { color: #1a1a1a; font-weight: 500; }
    .doc-title {
      font-size: 16pt;
      font-weight: 700;
      color: #10264c;
      margin-bottom: 4px;
    }
    .doc-number { font-size: 10pt; color: #888; margin-bottom: 20px; }
    .badge {
      display: inline-block;
      padding: 2px 10px;
      border-radius: 12px;
      font-size: 8pt;
      font-weight: 600;
      text-transform: uppercase;
    }
    .badge-draft { background: #e5e7eb; color: #555; }
    .badge-sent { background: #dbeafe; color: #1e40af; }
    .badge-paid { background: #d1fae5; color: #065f46; }
    .badge-partially-paid { background: #fef3c7; color: #92400e; }
    .notes { margin-top: 24px; padding: 12px 16px; background: #f8f8f8; border-left: 3px solid #10264c; font-size: 9pt; color: #555; }
    .notes .notes-label { font-weight: 600; color: #333; margin-bottom: 4px; }
  </style>
</head>
<body>
  <div class="pdf-header">
    <div class="company-name"><%= t("business.name") %></div>
    <div class="company-details">
      <%= t("business.phone") %><br>
      <%= t("business.address.full") %><br>
      <%= t("business.hours") %>
    </div>
  </div>

  <%= yield %>

  <div class="pdf-footer">
    <%= t("business.name") %> &middot; <%= t("business.phone") %> &middot; <%= t("business.address.full") %>
  </div>
</body>
</html>
