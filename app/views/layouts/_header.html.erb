<header class="sticky top-0 z-50 bg-primary/95 backdrop-blur-md shadow-lg border-b border-white/5" data-controller="mobile-menu">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-18">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <%= link_to root_path, class: "flex items-center gap-3 group" do %>
          <div class="avatar-accent w-10 h-10 rounded-xl shadow-lg group-hover:scale-105 transition-transform">
            <span class="font-extrabold text-lg">RW</span>
          </div>
          <div class="flex flex-col leading-tight">
            <span class="text-white text-xl font-bold tracking-wide"><%= t("business.name") %></span>
            <span class="text-gray-400 text-[10px] tracking-widest uppercase">~ A Cabinet Company ~</span>
          </div>
        <% end %>
      </div>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center space-x-1">
        <%= link_to "Home", root_path, class: "px-4 py-2 text-gray-300 hover:text-white rounded-lg hover:bg-white/10 transition-all duration-200 text-sm font-medium" %>

        <!-- Services dropdown -->
        <div class="relative group/services">
          <button class="px-4 py-2 text-gray-300 hover:text-white rounded-lg hover:bg-white/10 transition-all duration-200 text-sm font-medium inline-flex items-center gap-1">
            Services
            <svg class="w-3.5 h-3.5 group-hover/services:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <div class="invisible group-hover/services:visible opacity-0 group-hover/services:opacity-100 transition-all duration-200 absolute top-full left-0 pt-2 z-50">
            <div class="bg-primary-light rounded-xl shadow-2xl border border-white/10 py-2 whitespace-nowrap">
              <% I18n.t("business.services").each do |key, service| %>
                <% next unless service[:enabled] %>
                <%= link_to send(:"services_#{key}_path"), class: "block px-4 py-2.5 text-gray-300 hover:text-accent hover:bg-white/5 transition text-sm" do %><%= service[:name] %><% end %>
              <% end %>
            </div>
          </div>
        </div>

        <%= link_to "Gallery", gallery_path, class: "px-4 py-2 text-gray-300 hover:text-white rounded-lg hover:bg-white/10 transition-all duration-200 text-sm font-medium" %>
        <%= link_to "About", about_path, class: "px-4 py-2 text-gray-300 hover:text-white rounded-lg hover:bg-white/10 transition-all duration-200 text-sm font-medium" %>
        <%= link_to "Contact", contact_path, class: "px-4 py-2 text-gray-300 hover:text-white rounded-lg hover:bg-white/10 transition-all duration-200 text-sm font-medium" %>
      </nav>

      <!-- CTA + Mobile Toggle -->
      <div class="flex items-center gap-3">
        <%= link_to "tel:#{t('business.phone_raw')}", class: "btn-primary-sm hidden lg:inline-flex" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <%= t("business.phone") %>
        <% end %>

        <button data-action="mobile-menu#toggle" class="md:hidden text-white p-2 rounded-lg hover:bg-white/10 transition" aria-label="Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div data-mobile-menu-target="menu" class="hidden md:hidden bg-primary border-t border-white/10">
    <div class="px-4 pt-2 pb-6 space-y-1">
      <%= link_to "Home", root_path, class: "block text-gray-300 hover:text-white hover:bg-white/10 py-3 px-4 rounded-lg transition" %>

      <!-- Mobile services list -->
      <div class="py-1">
        <p class="text-gray-500 text-xs font-bold uppercase tracking-wider px-4 py-2">Services</p>
        <% I18n.t("business.services").each do |key, service| %>
          <% next unless service[:enabled] %>
          <%= link_to service[:name], send(:"services_#{key}_path"), class: "block text-gray-300 hover:text-white hover:bg-white/10 py-2.5 px-6 rounded-lg transition text-sm" %>
        <% end %>
      </div>

      <%= link_to "Gallery", gallery_path, class: "block text-gray-300 hover:text-white hover:bg-white/10 py-3 px-4 rounded-lg transition" %>
      <%= link_to "About", about_path, class: "block text-gray-300 hover:text-white hover:bg-white/10 py-3 px-4 rounded-lg transition" %>
      <%= link_to "Contact", contact_path, class: "block text-gray-300 hover:text-white hover:bg-white/10 py-3 px-4 rounded-lg transition" %>
      <div class="pt-3 border-t border-white/10">
        <%= link_to "tel:#{t('business.phone_raw')}", class: "flex items-center justify-center gap-2 py-3 px-4 bg-accent text-primary font-bold rounded-xl" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Call <%= t("business.phone") %>
        <% end %>
      </div>
    </div>
  </div>
</header>
