<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? yield(:title) : t("business.seo.title", business_name: t("business.name")) %></title>
  <meta name="description" content="<%= t("business.seo.description") %>">
  <meta name="keywords" content="<%= t("business.seo.keywords") %>">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <% if ENV["TURNSTILE_SITE_KEY"].present? %>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <% end %>
  <% if ENV["ENABLE_STRUCTURED_DATA"].present? %>
    <%= local_business_jsonld %>
    <%= services_jsonld %>
    <%= yield :structured_data %>
  <% end %>
</head>
<body class="font-sans text-gray-800 bg-white" data-controller="modal">
  <div class="bg-accent text-primary text-center text-xs font-semibold py-1.5 tracking-wide">
    Servicing <%= t("business.address.city") %>, <%= t("business.address.state") %> and surrounding areas
  </div>
  <%= render "layouts/header" %>
  <%= render "layouts/flash" %>
  <main>
    <%= yield %>
  </main>
  <%= render "layouts/footer" %>
  <%= render "shared/cta_floating" %>
  <%# render "shared/cta_exit_intent" %>
</body>
</html>
