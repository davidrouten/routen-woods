<h2><%= I18n.t("notifications.#{@event}.email_subject", name: @lead.first_name, service: @lead.service_names, status: @lead.status, from: @context[:from], to: @context[:to]) %></h2>

<% urgent = %w[asap within_month].include?(@lead.timeframe) %>
<% if urgent %>
<p style="background-color: #dc2626; color: white; padding: 12px 16px; border-radius: 6px; font-weight: bold; font-size: 16px;">
  URGENT — <%= I18n.t("business.timeframes.#{@lead.timeframe}.label", default: @lead.timeframe&.titleize) %> — Call back immediately!
</p>
<% end %>

<table style="width: 100%; border-collapse: collapse;">
  <tr>
    <td style="padding: 8px; font-weight: bold;">Name:</td>
    <td style="padding: 8px;"><%= @lead.first_name %> <%= @lead.last_name %></td>
  </tr>
  <% if @lead.email.present? %>
  <tr>
    <td style="padding: 8px; font-weight: bold;">Email:</td>
    <td style="padding: 8px;"><%= @lead.email %></td>
  </tr>
  <% end %>
  <% if @lead.phone.present? %>
  <% digits = @lead.phone.gsub(/\D/, "") %>
  <tr>
    <td style="padding: 8px; font-weight: bold;">Phone:</td>
    <td style="padding: 8px;"><a href="tel:+1<%= digits %>" style="color: #1b2a4a; text-decoration: underline;"><%= @lead.phone %></a></td>
  </tr>
  <% end %>
  <% if @lead.services_interested_in.present? %>
  <tr>
    <td style="padding: 8px; font-weight: bold;">Services:</td>
    <td style="padding: 8px;"><%= @lead.service_names %></td>
  </tr>
  <% end %>
  <% if @lead.budget_range.present? %>
  <tr>
    <td style="padding: 8px; font-weight: bold;">Budget:</td>
    <td style="padding: 8px;"><%= I18n.t("business.budget_ranges.#{@lead.budget_range}.label", default: @lead.budget_range&.titleize) %></td>
  </tr>
  <% end %>
  <% if @lead.timeframe.present? %>
  <tr>
    <td style="padding: 8px; font-weight: bold;">Timeframe:</td>
    <td style="padding: 8px;"><%= I18n.t("business.timeframes.#{@lead.timeframe}.label", default: @lead.timeframe&.titleize) %></td>
  </tr>
  <% end %>
  <% address = [@lead.address_street, @lead.address_street2, @lead.address_city, @lead.address_state, @lead.address_zip].compact_blank.join(", ") %>
  <% if address.present? %>
  <tr>
    <td style="padding: 8px; font-weight: bold;">Location:</td>
    <td style="padding: 8px;"><%= address %></td>
  </tr>
  <% end %>
  <% if @lead.message.present? %>
  <tr>
    <td style="padding: 8px; font-weight: bold;">Message:</td>
    <td style="padding: 8px;"><%= @lead.message %></td>
  </tr>
  <% end %>
</table>

<% if @lead.lead_temperature.present? %>
<p><strong>Lead Temperature:</strong> <%= @lead.temperature_emoji %> <%= @lead.lead_temperature.capitalize %></p>
<% end %>

<p style="margin-top: 20px;">
  <a href="<%= admin_lead_url(@lead) %>" style="background-color: #1b2a4a; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px;">View Lead</a>
</p>
