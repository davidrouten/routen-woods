<%= I18n.t("notifications.#{@event}.email_subject", name: @lead.first_name, service: @lead.service_names, status: @lead.status, from: @context[:from], to: @context[:to]) %>

Name: <%= @lead.first_name %> <%= @lead.last_name %>
<% if @lead.email.present? %>Email: <%= @lead.email %><% end %>
<% if @lead.phone.present? %>Phone: <%= @lead.phone %><% end %>
<% if @lead.services_interested_in.present? %>Services: <%= @lead.service_names %><% end %>
<% if @lead.message.present? %>Message: <%= @lead.message %><% end %>
<% if @lead.lead_temperature.present? %>Temperature: <%= @lead.lead_temperature.capitalize %><% end %>

View lead: <%= admin_lead_url(@lead) %>
