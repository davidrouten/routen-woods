<section id="gallery" class="py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-[#d4a338] font-semibold tracking-wider uppercase text-sm mb-3">Portfolio</p>
      <h2 class="text-4xl md:text-5xl font-extrabold text-[#0f1b2d] mb-4"><%= t("business.sections.gallery.heading") %></h2>
      <p class="text-gray-500 text-lg"><%= t("business.sections.gallery.subheading") %></p>
    </div>

    <% if images.any? %>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" data-controller="lightbox">
        <% images.each_with_index do |image, idx| %>
          <div class="group relative overflow-hidden rounded-2xl aspect-square bg-gray-200 shadow-sm hover:shadow-xl transition-all duration-500 cursor-pointer"
               data-lightbox-target="item"
               data-action="click->lightbox#open"
               data-lightbox-url="<%= image.image.attached? ? url_for(image.image.variant(resize_to_limit: [1600, 1600], format: :webp)) : '' %>">
            <% if image.image.attached? %>
              <%= responsive_gallery_image image.image, alt: image.title, eager: idx == 0,
                  class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center text-gray-300">
                <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
            <% end %>
            <div class="absolute inset-0 bg-gradient-to-t from-[#0f1b2d]/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-5">
              <p class="text-white font-semibold"><%= image.title %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16">
        <div class="w-20 h-20 mx-auto mb-6 bg-gray-100 rounded-2xl flex items-center justify-center">
          <svg class="w-10 h-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </div>
        <p class="text-gray-400 text-lg">Gallery coming soon! Check back for photos of our recent work.</p>
      </div>
    <% end %>

    <div class="text-center mt-10">
      <%= link_to gallery_path, class: "group inline-flex items-center gap-2 px-8 py-4 border-2 border-[#0f1b2d] text-[#0f1b2d] font-bold rounded-xl hover:bg-[#0f1b2d] hover:text-white transition-all duration-300" do %>
        View Full Gallery
        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      <% end %>
    </div>
  </div>
</section>
