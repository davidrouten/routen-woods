<section id="gallery" class="py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-[#0f1b2d] text-center mb-4"><%= t("business.sections.gallery.heading") %></h2>
    <p class="text-gray-600 text-center mb-12"><%= t("business.sections.gallery.subheading") %></p>

    <% if images.any? %>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <% images.each do |image| %>
          <div class="relative group overflow-hidden rounded-lg aspect-square bg-gray-200">
            <% if image.image.attached? %>
              <%= image_tag image.image, class: "w-full h-full object-cover group-hover:scale-105 transition duration-300", alt: image.title %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center text-gray-400">
                <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
            <% end %>
            <div class="absolute inset-0 bg-[#0f1b2d]/60 opacity-0 group-hover:opacity-100 transition flex items-end p-4">
              <p class="text-white font-semibold"><%= image.title %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-center text-gray-500">Gallery coming soon!</p>
    <% end %>

    <div class="text-center mt-8">
      <%= link_to "View Full Gallery", gallery_path, class: "inline-flex items-center px-6 py-3 border-2 border-[#0f1b2d] text-[#0f1b2d] font-semibold rounded-lg hover:bg-[#0f1b2d] hover:text-white transition" %>
    </div>
  </div>
</section>
