<section class="py-24 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-[#d4a338] font-semibold tracking-wider uppercase text-sm mb-3">Our Process</p>
      <h2 class="text-4xl md:text-5xl font-extrabold text-[#0f1b2d] mb-4"><%= t("business.process.heading") %></h2>
      <p class="text-gray-500 text-lg max-w-2xl mx-auto"><%= t("business.process.subheading") %></p>
    </div>

    <div class="relative">
      <!-- Connecting line (desktop) -->
      <div class="hidden lg:block absolute top-24 left-[12%] right-[12%] h-0.5 bg-gradient-to-r from-[#d4a338]/20 via-[#d4a338] to-[#d4a338]/20"></div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6">
        <% I18n.t("business.process.steps").each do |key, step| %>
          <div class="relative text-center group">
            <!-- Step number circle -->
            <div class="relative z-10 w-20 h-20 mx-auto mb-6 bg-white border-4 border-[#0f1b2d] rounded-full flex items-center justify-center group-hover:border-[#d4a338] group-hover:scale-110 transition-all duration-500 shadow-lg">
              <span class="text-2xl font-extrabold text-[#0f1b2d] group-hover:text-[#d4a338] transition-colors duration-300"><%= step[:number] %></span>
            </div>

            <h3 class="text-xl font-bold text-[#0f1b2d] mb-3"><%= step[:title] %></h3>
            <p class="text-gray-500 leading-relaxed"><%= step[:description] %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
