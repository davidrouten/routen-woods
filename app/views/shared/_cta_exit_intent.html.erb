<div data-controller="exit-intent" data-exit-intent-target="modal" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black/50" data-action="click->exit-intent#close"></div>
  <div class="absolute inset-0 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full p-8 relative">
      <button data-action="click->exit-intent#close" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
      <h3 class="text-2xl font-bold text-[#0f1b2d] mb-2"><%= t("business.cta.exit_intent_heading") %></h3>
      <p class="text-gray-600 mb-6"><%= t("business.cta.exit_intent_body") %></p>
      <%= link_to t("business.cta.exit_intent_cta"), contact_path, class: "block w-full text-center px-8 py-4 bg-[#d4a338] text-[#0f1b2d] font-bold rounded-lg text-lg hover:bg-[#b8860b] transition" %>
    </div>
  </div>
</div>
