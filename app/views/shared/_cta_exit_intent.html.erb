<div data-controller="exit-intent" data-exit-intent-target="modal" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" data-action="click->exit-intent#close"></div>
  <div class="absolute inset-0 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full overflow-hidden relative">
      <!-- Accent bar -->
      <div class="accent-bar"></div>

      <div class="p-8">
        <button data-action="click->exit-intent#close" class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 text-gray-400 hover:bg-gray-200 hover:text-gray-600 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>

        <div class="icon-box-accent w-16 h-16 mx-auto mb-6">
          <svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>

        <h3 class="text-2xl font-extrabold text-primary text-center mb-2"><%= t("business.cta.exit_intent_heading") %></h3>
        <p class="text-gray-500 text-center mb-8"><%= t("business.cta.exit_intent_body") %></p>

        <%= link_to contact_path, class: "btn-primary w-full group" do %>
          <%= t("business.cta.exit_intent_cta") %>
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        <% end %>
      </div>
    </div>
  </div>
</div>
