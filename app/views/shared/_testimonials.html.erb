<section id="testimonials" class="relative py-24 overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 bg-gradient-to-br from-[#0f1b2d] via-[#1b2a4a] to-[#0f1b2d]"></div>
  <div class="absolute inset-0 opacity-5" style="background-image: url('data:image/svg+xml,<svg width=&quot;60&quot; height=&quot;60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;><rect width=&quot;60&quot; height=&quot;60&quot; fill=&quot;none&quot; stroke=&quot;white&quot; stroke-width=&quot;0.5&quot;/></svg>');"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-[#d4a338] font-semibold tracking-wider uppercase text-sm mb-3">Testimonials</p>
      <h2 class="text-4xl md:text-5xl font-extrabold text-white mb-4"><%= t("business.sections.testimonials.heading") %></h2>
      <p class="text-gray-400 text-lg"><%= t("business.sections.testimonials.subheading") %></p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% testimonials.each do |testimonial| %>
        <div class="group bg-white/5 backdrop-blur-sm rounded-2xl p-8 border border-white/10 hover:bg-white/10 hover:border-[#d4a338]/30 transition-all duration-500 hover:-translate-y-1">
          <!-- Stars -->
          <div class="flex gap-1 mb-5">
            <% testimonial.rating.times do %>
              <svg class="w-5 h-5 text-[#d4a338]" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            <% end %>
          </div>

          <!-- Quote -->
          <div class="relative mb-6">
            <svg class="absolute -top-2 -left-2 w-8 h-8 text-[#d4a338]/20" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151C7.546 6.068 5.983 8.789 5.983 11H10v10H0z"/></svg>
            <p class="text-gray-300 leading-relaxed italic pl-4"><%= testimonial.body %></p>
          </div>

          <!-- Author -->
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-gradient-to-br from-[#d4a338] to-[#b8860b] rounded-full flex items-center justify-center text-[#0f1b2d] font-bold text-sm">
              <%= testimonial.author_name.split.map(&:first).join %>
            </div>
            <div>
              <p class="font-bold text-white"><%= testimonial.author_name %></p>
              <% if testimonial.author_title.present? %>
                <p class="text-gray-400 text-sm"><%= testimonial.author_title %></p>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
