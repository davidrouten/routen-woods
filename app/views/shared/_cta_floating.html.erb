<!-- Desktop: "Get a Quote" button -->
<div data-controller="floating-cta" class="fixed bottom-6 right-6 z-40 hidden" data-floating-cta-target="button">
  <%= link_to contact_path, class: "hidden md:inline-flex items-center gap-2 px-6 py-3 bg-accent text-primary font-bold rounded-full shadow-xl hover:bg-accent-hover hover:shadow-2xl hover:-translate-y-1 transition-all duration-300" do %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
    </svg>
    <%= t("business.cta.floating_button") %>
  <% end %>

  <!-- Mobile: pulsing phone button -->
  <%= link_to "tel:#{t('business.phone_raw')}", class: "md:hidden flex items-center justify-center w-14 h-14 bg-accent text-primary rounded-full shadow-xl animate-pulse-slow" do %>
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
    </svg>
  <% end %>
</div>

<style>
  @keyframes pulse-slow {
    0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(212, 163, 56, 0.7); }
    50% { transform: scale(1.05); box-shadow: 0 0 0 12px rgba(212, 163, 56, 0); }
  }
  .animate-pulse-slow { animation: pulse-slow 2s infinite; }
</style>
