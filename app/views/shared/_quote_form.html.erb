<%= form_with(model: lead, url: leads_path, id: "lead_form", class: "space-y-5", data: { controller: "form-timing", action: "submit->form-timing#submit" }) do |f| %>
  <% if lead.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-4">
      <ul class="list-disc list-inside text-red-700 text-sm">
        <% lead.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
      <p class="text-red-600 text-sm mt-3">If you are having trouble submitting this form, email us directly at <%= mail_to t("business.email"), t("business.email"), class: "font-semibold underline" %> and we'll reach out to you as soon as we can!</p>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div>
      <%= f.label :first_name, "First Name", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
      <%= f.text_field :first_name, placeholder: t("business.forms.quote.name_placeholder"), class: "input", required: true, data: { action: "focus->form-timing#start" } %>
    </div>
    <div>
      <%= f.label :last_name, "Last Name", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
      <%= f.text_field :last_name, class: "input" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div>
      <%= f.label :email, "Email", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
      <%= f.email_field :email, placeholder: t("business.forms.quote.email_placeholder"), class: "input" %>
    </div>
    <div>
      <%= f.label :phone, "Phone", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
      <%= f.telephone_field :phone, placeholder: t("business.forms.quote.phone_placeholder"), class: "input" %>
    </div>
  </div>

  <div>
    <p class="block text-sm font-semibold text-gray-700 mb-2"><%= t("business.forms.quote.service_label") %></p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
      <% service_checkbox_options.each do |name, key| %>
        <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
          <%= check_box_tag "lead[services_interested_in][]", key, lead.services_interested_in&.include?(key), class: "rounded border-gray-300 text-accent focus:ring-accent" %>
          <%= name %>
        </label>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div>
      <%= f.label :budget_range, "Budget Range", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
      <%= f.select :budget_range, budget_range_options, { include_blank: "Select budget..." }, class: "input" %>
    </div>
    <div>
      <%= f.label :timeframe, "Timeframe", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
      <%= f.select :timeframe, timeframe_options, { include_blank: "Select timeframe..." }, class: "input" %>
    </div>
  </div>

  <div>
    <%= f.label :zip_code, "Zip Code", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
    <%= f.text_field :zip_code, placeholder: "Enter your zip code", class: "input", maxlength: 10 %>
  </div>

  <div>
    <%= f.label :message, "Tell us about your project", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
    <%= f.text_area :message, placeholder: t("business.forms.contact.message_placeholder"), rows: 4, class: "input resize-none" %>
  </div>

  <%# Honeypot - hidden from real users %>
  <div class="hidden" aria-hidden="true">
    <%= f.text_field :honeypot_value, tabindex: "-1", autocomplete: "off" %>
  </div>

  <%# Form timing for spam detection %>
  <%= f.hidden_field :form_completion_seconds, value: "", data: { "form-timing-target": "completionField" } %>

  <%# Cloudflare Turnstile - only rendered when configured %>
  <% if ENV["TURNSTILE_SITE_KEY"].present? %>
    <div class="cf-turnstile" data-sitekey="<%= ENV["TURNSTILE_SITE_KEY"] %>" data-theme="light" data-size="flexible"></div>
  <% end %>

  <div>
    <%= f.submit t("business.forms.quote.submit"), class: "btn-primary w-full" %>
  </div>

  <p class="text-center text-gray-400 text-xs">We respond to all inquiries within 24 hours. Your information is never shared.</p>
<% end %>
