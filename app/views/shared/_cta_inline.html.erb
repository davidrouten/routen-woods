<section class="relative py-20 overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 bg-gradient-to-r from-primary to-primary-light"></div>
  <div class="absolute inset-0 opacity-10">
    <div class="glow-orb -top-20 -right-20 w-80 h-80"></div>
    <div class="glow-orb -bottom-20 -left-20 w-80 h-80"></div>
  </div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-4"><%= t("business.cta.inline_after_services") %></h2>
    <p class="text-gray-300 text-lg mb-8 max-w-2xl mx-auto">Join hundreds of happy Oxford, Michigan homeowners who transformed their kitchens with us.</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <%= link_to contact_path, class: "btn-primary group" do %>
        <%= t("business.hero.cta_primary") %>
        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      <% end %>
      <%= link_to "tel:#{t('business.phone_raw')}", class: "btn-outline" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        Call <%= t("business.phone") %>
      <% end %>
    </div>
  </div>
</section>
