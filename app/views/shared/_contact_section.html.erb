<section id="contact" class="relative <%= local_assigns.fetch(:show_header, true) ? 'py-24' : 'pt-8 pb-24' %>">
  <!-- Angled top edge -->
  <div class="absolute top-0 left-0 right-0 -translate-y-full">
    <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="w-full h-12 md:h-16">
      <path d="M0 60L1440 60L1440 0C1200 60 240 60 0 0L0 60Z" fill="white"/>
    </svg>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <% if local_assigns.fetch(:show_header, true) %>
      <div class="text-center mb-16">
        <p class="section-label">Get Started</p>
        <h2 class="section-heading"><%= t("business.sections.contact.heading") %></h2>
        <p class="text-gray-500 text-lg"><%= t("business.sections.contact.subheading") %></p>
      </div>
    <% end %>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
      <!-- Form -->
      <div class="lg:col-span-3">
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-8 md:p-10">
          <%= render "shared/quote_form", lead: lead, form_page: local_assigns[:form_page] || "unknown" %>
        </div>
      </div>

      <!-- Contact info sidebar -->
      <div class="lg:col-span-2 space-y-6">
        <div class="bg-gradient-to-br from-primary to-primary-light rounded-2xl p-8 text-white">
          <h3 class="text-xl font-bold mb-6">Contact Information</h3>

          <div class="space-y-5">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-white/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <p class="text-gray-300 text-sm mb-1">Phone</p>
                <%= link_to t("business.phone"), "tel:#{t('business.phone_raw')}", class: "text-white hover:text-accent transition font-medium" %>
              </div>
            </div>

            <% if t("business.email", default: nil).present? %>
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-white/10 rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <div>
                  <p class="text-gray-300 text-sm mb-1">Email</p>
                  <%= mail_to t("business.email"), t("business.email"), class: "text-white hover:text-accent transition font-medium" %>
                </div>
              </div>
            <% end %>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-white/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <p class="text-gray-300 text-sm mb-1">Location</p>
                <p class="font-medium"><%= t("business.address.full") %></p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-white/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <p class="text-gray-300 text-sm mb-1">Hours</p>
                <p class="font-medium"><%= t("business.hours") %></p>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-accent/10 rounded-2xl p-6 border border-accent/20">
          <div class="flex items-center gap-3 mb-3">
            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <p class="font-bold text-primary">Quick Response</p>
          </div>
          <p class="text-gray-600 text-sm">We respond to all inquiries within 24 hours. Need help sooner? Give us a call!</p>
        </div>
      </div>
    </div>
  </div>
</section>
