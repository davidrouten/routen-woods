<section id="about" class="py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-[#0f1b2d] text-center mb-4"><%= t("business.sections.about.heading") %></h2>
    <p class="text-gray-600 text-center mb-12 max-w-2xl mx-auto"><%= t("business.sections.about.body") %></p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% I18n.t("business.sections.about.values").each do |key, value| %>
        <div class="text-center p-6">
          <div class="w-16 h-16 mx-auto mb-6 bg-[#d4a338]/10 rounded-full flex items-center justify-center">
            <svg class="w-8 h-8 text-[#d4a338]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[#0f1b2d] mb-3"><%= value[:title] %></h3>
          <p class="text-gray-600"><%= value[:description] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
