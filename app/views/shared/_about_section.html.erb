<%
  value_icons = {
    "craftsmanship" => '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>',
    "materials" => '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>',
    "satisfaction" => '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>',
    "licensed" => '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>'
  }
%>

<section id="about" class="py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-[#d4a338] font-semibold tracking-wider uppercase text-sm mb-3">Why Us</p>
      <h2 class="text-4xl md:text-5xl font-extrabold text-[#0f1b2d] mb-4"><%= t("business.sections.about.heading") %></h2>
      <p class="text-gray-500 text-lg max-w-2xl mx-auto"><%= t("business.sections.about.body") %></p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <% I18n.t("business.sections.about.values").each do |key, value| %>
        <div class="group text-center p-8 rounded-2xl hover:bg-white hover:shadow-xl transition-all duration-500">
          <div class="w-16 h-16 mx-auto mb-6 bg-[#d4a338]/10 rounded-2xl flex items-center justify-center group-hover:bg-[#d4a338] transition-all duration-500 group-hover:rotate-6 group-hover:scale-110">
            <svg class="w-8 h-8 text-[#d4a338] group-hover:text-white transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <%= raw(value_icons[key.to_s] || value_icons["satisfaction"]) %>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-[#0f1b2d] mb-3"><%= value[:title] %></h3>
          <p class="text-gray-500 leading-relaxed"><%= value[:description] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
