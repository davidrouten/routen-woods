<%
  service_icons = {
    "cabinet_refinishing" => '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>',
    "cabinet_painting" => '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>',
    "cabinet_refacing" => '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/>',
    "custom_staining" => '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>'
  }
%>

<section id="services" class="py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-[#d4a338] font-semibold tracking-wider uppercase text-sm mb-3">What We Do</p>
      <h2 class="text-4xl md:text-5xl font-extrabold text-[#0f1b2d] mb-4">Our Services</h2>
      <p class="text-gray-500 text-lg max-w-2xl mx-auto">Professional cabinet services tailored to your needs and budget</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <% I18n.t("business.services").each do |key, service| %>
        <div id="<%= key %>" class="group relative bg-white rounded-2xl p-8 shadow-sm hover:shadow-2xl transition-all duration-500 border border-gray-100 hover:border-[#d4a338]/30 hover:-translate-y-2">
          <!-- Accent line -->
          <div class="absolute top-0 left-8 right-8 h-1 bg-gradient-to-r from-[#d4a338] to-[#b8860b] rounded-b-full opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

          <div class="w-16 h-16 mb-6 bg-gradient-to-br from-[#0f1b2d] to-[#1b2a4a] rounded-2xl flex items-center justify-center group-hover:bg-gradient-to-br group-hover:from-[#d4a338] group-hover:to-[#b8860b] transition-all duration-500 group-hover:rotate-3 group-hover:scale-110 shadow-lg">
            <svg class="w-8 h-8 text-[#d4a338] group-hover:text-white transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <%= raw(service_icons[key.to_s] || service_icons["cabinet_refinishing"]) %>
            </svg>
          </div>

          <h3 class="text-xl font-bold text-[#0f1b2d] mb-3 group-hover:text-[#d4a338] transition-colors duration-300"><%= service[:name] %></h3>
          <p class="text-gray-500 mb-5 leading-relaxed"><%= service[:short_description] %></p>
          <p class="text-[#d4a338] font-bold text-lg"><%= service[:price_starting] %></p>

          <%= link_to services_path(anchor: key), class: "mt-5 inline-flex items-center gap-1 text-sm font-semibold text-[#0f1b2d] group-hover:text-[#d4a338] transition-colors" do %>
            Learn More
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>
