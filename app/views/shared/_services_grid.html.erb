<section id="services" class="py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="section-label">What We Do</p>
      <h2 class="section-heading">Our Services</h2>
      <p class="text-gray-500 text-lg max-w-2xl mx-auto">Professional cabinet services tailored to your needs</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% I18n.t("business.services").each do |key, service| %>
        <div id="<%= key %>" class="group relative bg-white rounded-2xl p-8 shadow-sm hover:shadow-2xl transition-all duration-500 border border-gray-100 hover:border-accent/30 hover:-translate-y-2">
          <!-- Accent line -->
          <div class="absolute top-0 left-8 right-8 h-1 bg-gradient-to-r from-accent to-accent-hover rounded-b-full opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

          <div class="w-16 h-16 mb-6 bg-gradient-to-br from-primary to-primary-light rounded-2xl flex items-center justify-center group-hover:bg-gradient-to-br group-hover:from-accent group-hover:to-accent-hover transition-all duration-500 group-hover:rotate-3 group-hover:scale-110 shadow-lg">
            <svg class="w-8 h-8 text-accent group-hover:text-white transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <%= raw(service_icons[key.to_s] || service_icons["cabinet_refacing"]) %>
            </svg>
          </div>

          <h3 class="text-xl font-bold text-primary mb-3 group-hover:text-accent transition-colors duration-300"><%= service[:name] %></h3>
          <p class="text-gray-500 mb-5 leading-relaxed"><%= service[:short_description] %></p>

          <%= link_to services_path(anchor: key), class: "mt-5 inline-flex items-center gap-1 text-sm font-semibold text-primary group-hover:text-accent transition-colors" do %>
            Learn More
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>
