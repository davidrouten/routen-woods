<section id="services" class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-[#0f1b2d] text-center mb-4">Our Services</h2>
    <p class="text-gray-600 text-center mb-12 max-w-2xl mx-auto">Professional cabinet services tailored to your needs and budget</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <% I18n.t("business.services").each do |key, service| %>
        <div id="<%= key %>" class="bg-white rounded-xl shadow-md hover:shadow-xl transition p-8 text-center group">
          <div class="w-16 h-16 mx-auto mb-6 bg-[#0f1b2d] rounded-full flex items-center justify-center group-hover:bg-[#d4a338] transition">
            <svg class="w-8 h-8 text-[#d4a338] group-hover:text-[#0f1b2d] transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[#0f1b2d] mb-3"><%= service[:name] %></h3>
          <p class="text-gray-600 mb-4"><%= service[:short_description] %></p>
          <p class="text-[#d4a338] font-semibold"><%= service[:price_starting] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
