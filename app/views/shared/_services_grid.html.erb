<%
  # Six service panels — each is one big clickable button.
  # "cabinet_customize_repair" combines Customization, Accessories & Repair.
  services = [
    {
      path:  services_cabinet_refacing_path,
      title: "Cabinet Refacing",
      blurb: "New 3DL or wood doors and drawer fronts with new laminate frames and finished ends on your existing cabinets.",
      icon:  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/>'
    },
    {
      path:  services_cabinet_repainting_path,
      title: "Cabinet Repainting",
      blurb: "Stripping and repainting your doors and drawer fronts with professional finishes, plus frames and finished ends.",
      icon:  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>'
    },
    {
      path:  services_cabinet_installation_path,
      title: "Cabinet Installation",
      blurb: "Have cabinets that need installing? Or need to design, order, and install new ones? We handle it all.",
      icon:  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>'
    },
    {
      path:  services_cabinet_customize_repair_path,
      title: "Customization, Repair & Accessories",
      blurb: "Repairs, custom modifications for new appliances, plus roll-out trays, trash pull-outs, spice racks, and more.",
      icon:  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>'
    },
    {
      path:  services_custom_closets_path,
      title: "Custom Closets & Pantries",
      blurb: "Custom spaces tailored to you and your life's accessories.",
      icon:  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zM14 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/>'
    },
    {
      path:  services_countertops_path,
      title: "Countertops",
      blurb: "Fabricate and install: wood (butcher's block or veneer), laminate, or solid surface countertops.",
      icon:  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 6v12a2 2 0 002 2h12a2 2 0 002-2V6M4 6l1-2h14l1 2"/>'
    }
  ]
%>

<section id="services" class="pt-16 pb-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="section-label">What We Do</p>
      <h2 class="section-heading">Our Services</h2>
      <p class="text-gray-500 text-lg max-w-2xl mx-auto">Find the right service for your project</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% services.each do |svc| %>
        <%= link_to svc[:path],
              class: "group relative block bg-white rounded-2xl p-8 shadow-sm border border-gray-100
                       hover:shadow-2xl hover:border-accent/30 hover:-translate-y-2
                       transition-all duration-500 text-left no-underline" do %>

          <%# Accent line on hover %>
          <div class="absolute top-0 left-8 right-8 h-1 bg-gradient-to-r from-accent to-accent-hover rounded-b-full opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

          <div class="w-14 h-14 mb-5 bg-gradient-to-br from-primary to-primary-light rounded-xl flex items-center justify-center group-hover:from-accent group-hover:to-accent-hover transition-all duration-500 group-hover:rotate-3 group-hover:scale-110 shadow-lg">
            <svg class="w-7 h-7 text-accent group-hover:text-white transition-colors duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <%= raw(svc[:icon]) %>
            </svg>
          </div>

          <h3 class="text-lg font-bold text-primary mb-2 group-hover:text-accent transition-colors duration-300"><%= svc[:title] %></h3>
          <p class="text-gray-500 text-sm leading-relaxed mb-4"><%= svc[:blurb] %></p>

          <span class="inline-flex items-center gap-1 text-sm font-semibold text-primary group-hover:text-accent transition-colors">
            Learn More
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
